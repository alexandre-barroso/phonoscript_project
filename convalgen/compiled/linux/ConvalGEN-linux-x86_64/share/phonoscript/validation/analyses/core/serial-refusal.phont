#!/usr/bin/env phonoscript
// Generic trajectory comparison: a missing target serial ledger is a
// structured QE-TRAJECTORY refusal, not inequality or an empty output.
project_title("Structured serial-trajectory refusal")
project_evaluator("OT")
dataset_clear()

tableau_select("source")
tableau_name("Source serial grammar")
tableau_input("/x/")
constraints_clear()
candidates_clear()
constraint_add("C", 1)
candidate_add("a", "[a]", [0])
serial_side("source")
serial_start("x")
serial_clear()
serial_move("x", "a", "change", [0])
serial_move("a", "a", "identity", [0])
assert(serial_evaluate()["formed"])

tableau_select("target")
tableau_name("Target without a serial ledger")
tableau_input("/x/")
constraints_clear()
candidates_clear()
constraint_add("C", 1)
candidate_add("a", "[a]", [0])
serial_side("target")
serial_start("x")
serial_clear()

second_query("winner_set")
second_answer_sort("ordered derivational trajectory")
second_scope("complete source and target trajectories")
second_transformation("remove the target serial ledger")
second_transport("identity on serial states")
second_response_domain("trajectory")
let result = second_compare()
assert_equal(result["status"], "NOT EVALUATED")
assert_equal(result["refusal"]["code"], "QE-TRAJECTORY")
assert_equal(result["refusal"]["coordinate"], "response.target-trajectory")
