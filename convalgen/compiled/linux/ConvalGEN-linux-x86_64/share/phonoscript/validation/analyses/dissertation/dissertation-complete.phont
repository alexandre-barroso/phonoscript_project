begin_record("H.16 Walker boundary", "Walker cell", "HG", "Dissertation EN/PT-BR; tab:apph-walker-replay; id 8 boundary; fidelity:exact")
add_constraint("printed cost", 1, 0)
add_row("assimilation", [17], 1)
add_row("faithful", [17], 1)
assert_winners(["assimilation", "faithful"])

// fig:apph-pater-scaling-tableau; fidelity:snapshot-only.
begin_record("H.17 Hidden-candidate MaxEnt fibre", "one hidden-candidate input", "MaxEnt", "Dissertation EN/PT-BR; fig:apph-pater-scaling-tableau; panel:apph-pater-source; fidelity:snapshot-only (t=log 2 represented by base masses)")
add_constraint("score", 0, 0)
add_row("a->A", [0], 1)
add_row("b->A", [0], 1)
add_row("c->A", [0], 1)
add_row("d->B", [0], 2)
assert_winners(["d->B"])

// fig:apph-cabrera-consumer-tableaux, one-shot panel; fidelity:exact.
begin_record("H.18 One-shot support", "n=0,...,5", "MaxEnt", "Dissertation EN/PT-BR; fig:apph-cabrera-consumer-tableaux; panel:apph-cabrera-one-shot; eq:apph-cabrera-one-shot; fidelity:exact")
add_constraint("Markedness", 1/2, 0)
add_row("c0", [0], 1)
add_row("c1", [1], 1)
add_row("c2", [2], 1)
add_row("c3", [3], 1)
add_row("c4", [4], 1)
add_row("c5", [5], 1)
