// fig:appe-smallest-maxent; fidelity:exact-transform.
begin_record("E.1 Smallest MaxEnt tableau", "/u/", "MaxEnt", "Dissertation EN/PT-BR; fig:appe-smallest-maxent; sec:app-maxent-cross-product; fidelity:exact-transform (w=1 specialization)")
