// fig:appe-polynomial-ledgers, /u-prime/ block; fidelity:exact-transform.
begin_record("E.3 Polynomial ledger /u'/", "/u'/", "MaxEnt", "Dissertation EN/PT-BR; fig:appe-polynomial-ledgers; block:/u-prime/; eq:app-maxent-compiler; fidelity:exact-transform (w=1 specialization)")
