// Independently calculated, label-preserving reparameterization of the
// complete-order comparison in fig:intro-sot-opening.
tableau_select("source")
tableau_name("Second-Order source")
tableau_input("/ab/")
tableau_source_locator("Dissertation EN/PT-BR; fig:intro-sot-opening; panel:intro-neutral-source; fidelity:exact-transform (candidate and constraint labels reparameterized)")
tableau_evaluator("OT")
constraints_clear()
candidates_clear()
add_constraint("IDENT-IO(voice)", 1, 0)
add_constraint("MAX-IO", 1, 1)
candidate_add("ab", "[ab]", [0, 0], 1, 0)
candidate_add("ap", "[ap]", [1, 0], 1, 0)
candidate_add("a", "[a]", [0, 1], 1, 0)
assert_winners(["ab"])

tableau_select("target")
tableau_name("Second-Order target")
tableau_input("/ab/")
tableau_source_locator("Dissertation EN/PT-BR; fig:intro-sot-opening; encoded target response; fidelity:exact-transform (candidate and constraint labels reparameterized)")
tableau_evaluator("OT")
constraints_clear()
candidates_clear()
add_constraint("MAX-IO", 1, 0)
add_constraint("IDENT-IO(voice)", 1, 1)
candidate_add("ab", "[ab]", [0, 0], 1, 0)
candidate_add("ap", "[ap]", [0, 1], 1, 0)
candidate_add("a", "[a]", [1, 0], 1, 0)
assert_winners(["ab"])

second_query("complete_order")
second_answer_sort("preorder on all registered candidates")
second_scope("complete order of ab, ap, and a")
second_transformation("rerank IDENT-IO(voice) and MAX-IO")
second_transport("identity on ab, ap, and a")
second_mode("exact")
second_tolerance(1/1000000000)
second_grid_step(1/1000)
second_response_domain("terminal")
second_normalizer("independent")
second_layout("overlay")
second_layers("grammar", "grammar")
second_layer_transport("identity")
second_consumer("direct", "")
let comparison = second_compare()
assert_equal(comparison["status"], "DISCREPANCY")
assert_equal(len(comparison["discrepancies"]), 2)

tableau_select("H.5 Basic Syllable /CV/")
assert(q_clone("Onset")["support_conservative"])
assert_equal(len(evaluate()["rows"]), 4)
