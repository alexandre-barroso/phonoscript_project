begin_record("2.7 Refusal source fibre", "source fibre", "MaxEnt", "Dissertation EN/PT-BR; fig:calc-ex10-sot; panel:calc2-refusal-source; query:calc2-merger-refusal; fidelity:source-panel-only (not the structured refusal)")
add_constraint("Faith", 0, 0)
add_row("a1", [0], 1)
add_row("a2", [0], 1)
add_row("b", [0], 1)
