// fig:appe-polynomial-ledgers, /u/ block; fidelity:exact-transform.
begin_record("E.2 Polynomial ledger /u/", "/u/", "MaxEnt", "Dissertation EN/PT-BR; fig:appe-polynomial-ledgers; block:/u/; eq:app-maxent-compiler; fidelity:exact-transform (w=1 specialization)")
add_constraint("C", 1, 0)
