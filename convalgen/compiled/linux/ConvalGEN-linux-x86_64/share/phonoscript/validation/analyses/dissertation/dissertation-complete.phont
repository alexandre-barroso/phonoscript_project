begin_record("H.19 Binary MParse boundary", "n=3", "MaxEnt", "Dissertation EN/PT-BR; fig:apph-cabrera-consumer-tableaux; panel:apph-cabrera-binary; eq:apph-cabrera-binary; fidelity:exact")
add_constraint("Markedness", 1/2, 0)
add_constraint("MParse", 3/2, 1)
add_row("c3", [3, 0], 1)
add_row("null", [0, 1], 1)
