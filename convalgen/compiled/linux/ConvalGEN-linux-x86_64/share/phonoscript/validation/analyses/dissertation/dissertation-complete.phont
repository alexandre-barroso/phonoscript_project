add_row("a-prime", [0], 1)
add_row("c1", [1], 1)
add_row("c2", [1], 1)
assert_winners(["a-prime"])

fn neutral_three(name, locator_marker) {
    begin_record(name, "/u/", "OT", locator_marker)
    add_constraint("C1", 1, 0)
    add_constraint("C2", 1, 1)
    add_row("a", [0, 0], 1)
    add_row("b", [0, 1], 1)
    add_row("c", [1, 0], 1)
    assert_equal(len(evaluate()["rows"]), 3)
    assert(len(locator_marker) > 0)
}

// fig:intro-neutral-profiles; fidelity:neutral-ledger.
neutral_three("1.1 Neutral profile", "Dissertation EN/PT-BR; fig:intro-neutral-profiles; sec:intro-opening; fidelity:neutral-ledger (input renamed /x/ to /u/)")

