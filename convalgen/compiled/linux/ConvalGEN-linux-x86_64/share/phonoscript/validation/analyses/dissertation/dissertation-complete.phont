#!/usr/bin/env phonoscript
// Dissertation tableau validation project: 39 bounded first-order records and
// one typed complete-order comparison. Every locator names a stable LaTeX
// label shared by the English and Portuguese dissertations and declares its
// fidelity ceiling. Neutral displays assert only their registered support
// size; they do not acquire an invented winner oracle. The engine calculates
// every asserted answer independently.
project_title("Dissertation tableau validation project")
project_author("Alexandre Menezes Barroso")
project_description("Bounded dissertation transcription with independently calculated regression oracles.")
project_evaluator("OT")
project_temperature(1)
dataset_clear()

fn begin_record(name, input_form, evaluator, locator) {
    tableau_new(name, input_form)
    tableau_evaluator(evaluator)
    tableau_source_locator(locator)
    tableau_ties("retain")
    constraints_clear()
    candidates_clear()
}

fn add_constraint(name, weight, stratum) {
    constraint_add(name, weight, "", stratum)
}

fn add_row(name, marks, mass) {
    candidate_add(name, name, marks, mass, 0)
}

// fig:apph-neutral-selection-tableau; fidelity:exact.
begin_record("H.1 Neutral HG selection", "/x/", "HG", "Dissertation EN/PT-BR; fig:apph-neutral-selection-tableau; sec:apph-pairwise-versus-selection; fidelity:exact")
add_constraint("C1", 2, 0)
add_constraint("C2", 1, 1)
add_row("a", [0, 0], 1)
add_row("b", [1, 0], 1)
add_row("c", [0, 1], 1)
assert_winners(["a"])

// tab:apph-gd-score-replay, x block; fidelity:exact-transform.
begin_record("H.2 Goldrick-Daland x score replay", "x=(1,0)", "HG", "Dissertation EN/PT-BR; tab:apph-gd-score-replay; block:apph-gd-input-x; eq:apph-gd-score-rows; fidelity:exact-transform (cost=20-H)")
add_constraint("order-preserving cost", 1, 0)
add_row("0", [20], 1)
add_row("y", [0], 1)
add_row("u", [37], 1)
add_row("z", [19], 1)
assert_winners(["y"])

// tab:apph-gd-score-replay, w block; fidelity:exact-transform.
begin_record("H.3 Goldrick-Daland w score replay", "w=(0,1)", "HG", "Dissertation EN/PT-BR; tab:apph-gd-score-replay; block:apph-gd-input-w; eq:apph-gd-score-rows; fidelity:exact-transform (cost=18-H)")
add_constraint("order-preserving cost", 1, 0)
add_row("0", [18], 1)
add_row("y", [15], 1)
add_row("u", [1], 1)
add_row("z", [0], 1)
assert_winners(["z"])

// tab:apph-mccollum-grid; fidelity:exact-transform.
begin_record("H.4 Exact tenths-grid objective", "x=0,...,1", "HG", "Dissertation EN/PT-BR; tab:apph-mccollum-grid; sec:apph-mccollum; fidelity:exact-transform (100 J1(x))")
add_constraint("100 J1(x)", 1, 0)
add_row("x=0", [2100], 1)
add_row("x=1/10", [1711], 1)
add_row("x=1/5", [1364], 1)
add_row("x=3/10", [1059], 1)
add_row("x=2/5", [796], 1)
add_row("x=1/2", [575], 1)
add_row("x=3/5", [396], 1)
add_row("x=7/10", [259], 1)
add_row("x=4/5", [164], 1)
add_row("x=9/10", [111], 1)
add_row("x=1", [100], 1)
assert_winners(["x=1"])

fn basic_syllable_constraints() {
    add_constraint("Onset", 1, 0)
    add_constraint("NoCoda", 1, 1)
    add_constraint("Dep", 1, 2)
    add_constraint("Max", 1, 3)
}

// tab:apph-basic-tensor, /CV/ block; fidelity:neutral-ledger.
begin_record("H.5 Basic Syllable /CV/", "/CV/", "OT", "Dissertation EN/PT-BR; tab:apph-basic-tensor; block:/CV/; fidelity:neutral-ledger")
basic_syllable_constraints()
add_row("CV", [0, 0, 0, 0], 1)
add_row("CVC", [0, 1, 1, 0], 1)
add_row("V", [1, 0, 0, 1], 1)
add_row("VC", [1, 1, 1, 1], 1)
assert_equal(len(evaluate()["rows"]), 4)

// tab:apph-basic-tensor, /CVC/ block; fidelity:neutral-ledger.
begin_record("H.6 Basic Syllable /CVC/", "/CVC/", "OT", "Dissertation EN/PT-BR; tab:apph-basic-tensor; block:/CVC/; fidelity:neutral-ledger")
basic_syllable_constraints()
add_row("CV", [0, 0, 0, 1], 1)
add_row("CVC", [0, 1, 0, 0], 1)
add_row("V", [1, 0, 0, 2], 1)
add_row("VC", [1, 1, 0, 1], 1)
assert_equal(len(evaluate()["rows"]), 4)

// tab:apph-basic-tensor, /V/ block; fidelity:neutral-ledger.
begin_record("H.7 Basic Syllable /V/", "/V/", "OT", "Dissertation EN/PT-BR; tab:apph-basic-tensor; block:/V/; fidelity:neutral-ledger")
basic_syllable_constraints()
add_row("CV", [0, 0, 1, 0], 1)
add_row("CVC", [0, 1, 2, 0], 1)
add_row("V", [1, 0, 0, 0], 1)
add_row("VC", [1, 1, 1, 0], 1)
assert_equal(len(evaluate()["rows"]), 4)

// tab:apph-basic-tensor, /VC/ block; fidelity:neutral-ledger.
begin_record("H.8 Basic Syllable /VC/", "/VC/", "OT", "Dissertation EN/PT-BR; tab:apph-basic-tensor; block:/VC/; fidelity:neutral-ledger")
basic_syllable_constraints()
add_row("CV", [0, 0, 1, 1], 1)
add_row("CVC", [0, 1, 1, 0], 1)
add_row("V", [1, 0, 0, 1], 1)
add_row("VC", [1, 1, 0, 0], 1)
assert_equal(len(evaluate()["rows"]), 4)

fn walker_cell(name, assimilation_cost, faithful_cost, expected, locator) {
    begin_record(name, "Walker cell", "HG", locator)
    add_constraint("printed cost", 1, 0)
    add_row("assimilation", [assimilation_cost], 1)
    add_row("faithful", [faithful_cost], 1)
    assert_winners([expected])
}

// tab:apph-walker-replay, ids 1–7.
walker_cell("H.9 Walker source 1", 15, 18, "assimilation", "Dissertation EN/PT-BR; tab:apph-walker-replay; id 1; fidelity:exact")
walker_cell("H.10 Walker source 2", 15, 20, "assimilation", "Dissertation EN/PT-BR; tab:apph-walker-replay; id 2; fidelity:exact")
walker_cell("H.11 Walker source 3", 17, 16, "faithful", "Dissertation EN/PT-BR; tab:apph-walker-replay; id 3; fidelity:exact")
walker_cell("H.12 Walker source 4", 17, 20, "assimilation", "Dissertation EN/PT-BR; tab:apph-walker-replay; id 4; fidelity:exact")
walker_cell("H.13 Walker source 5", 19, 16, "faithful", "Dissertation EN/PT-BR; tab:apph-walker-replay; id 5; fidelity:exact")
walker_cell("H.14 Walker source 6", 19, 18, "faithful", "Dissertation EN/PT-BR; tab:apph-walker-replay; id 6; fidelity:exact")
walker_cell("H.15 Walker interior witness", 170, 176, "assimilation", "Dissertation EN/PT-BR; tab:apph-walker-replay; id 7 new witness; fidelity:exact-transform (10P)")

