#!/usr/bin/env phonoscript
# Language conformance: exact values, null, quoted keys, nesting, and equality.

let source = {
    name: "exact record",
    "optional note": null,
    ratio: 1/3,
    nested: {
        symbols: ["σ", "t͡ʃ", "ə"],
        admitted: true,
    },
}

let reordered = {
    nested: { admitted: true, symbols: ["σ", "t͡ʃ", "ə"] },
    ratio: 2/6,
    "optional note": null,
    name: "exact record",
}

assert_equal(source, reordered)
assert_equal(source["optional note"], null)
assert_equal(source["ratio"], 1/3)
assert_equal(source["nested"]["symbols"][1], "t͡ʃ")
assert_equal(len(source), 4)

