#!/usr/bin/env phonoscript
// Generic strict-OT tie-policy and complete-order conformance fixture.
project_title("Strict-OT ties and explicit resolution")
project_evaluator("OT")
dataset_clear()
tableau_select("source")
tableau_name("Co-winners")
tableau_input("/x/")
constraints_clear()
candidates_clear()
constraint_add("C1", 1, "", 0)
constraint_add("C2", 1, "", 1)
candidate_add("a", "[a]", [0, 0])
candidate_add("b", "[b]", [0, 0])
tableau_ties("retain")
assert_winners(["a", "b"])
tableau_ties("first")
assert_winners(["a"])
tableau_ties("unique")
let unresolved = evaluate()
assert(unresolved["tie_unresolved"])
assert_equal(len(unresolved["winners"]), 0)
tableau_ties("retain")
constraint_tie("C1", "C2")
assert_winners(["a", "b"])
