#!/usr/bin/env phonoscript
// Generic finite GEN1-style convergence test. The strings and ONS/HNUC marks
// are derivative smoke data, not a transcription of McCarthy 2000.
project_title("Generic finite GEN1 serial smoke test")
project_evaluator("OT")
dataset_clear()
tableau_select("source")
tableau_name("Generic serial base")
tableau_input("/txznt/")
constraints_clear()
candidates_clear()
constraint_add("ONS", 1, "", 0)
constraint_add("HNUC", 1, "", 1)
candidate_add("first-local-winner", "tx(zN)t", [0, 0])
serial_side("source")
serial_start("txznt")
serial_limit(8)
serial_clear()
serial_move("txznt", "txznt", "identity", [1, 2])
serial_move("txznt", "tx(zN)t", "construct one nucleus", [0, 0])
serial_move("tx(zN)t", "tx(zN)t", "identity", [0, 0])
let derivation = serial_evaluate()
assert(derivation["formed"])
assert_equal(derivation["path"], ["txznt", "tx(zN)t"])
assert_equal(derivation["operations"], ["construct one nucleus"])
assert_equal(derivation["stopped"], "faithful convergence")
