\cs_new:Npn \__sot_query_record:nnnnnnnnn #1#2#3#4#5#6#7#8#9
  {
    %% Each query is an independently capped record.  The vertical rule is a
    %% query-local no-upcast terminus; it never encloses sibling queries or the
    %% first-order tableau.  The recoverable ceiling text remains in the foot.
    \noindent\hbox_to_wd:nn {\linewidth}
      {
        \vbox
          {
            \hsize=\dim_eval:n {\linewidth-.8em}
            \linewidth=\hsize
            \begin{tabularx}{\linewidth}{@{}lXr@{}}
              \textbf{#1}\,[\textsc{#2}] & & #9
            \end{tabularx}
            \par\nobreak\vspace{-.15ex}\noindent #3
            \str_if_eq:VnTF \l__sot_comp_disclosure_tl {compact}
              {
                \par\nobreak\vspace{-.25ex}\noindent\scriptsize
                \textsc{\__sot_transport_word:}:\,#4\par\vspace{.2ex}
              }
              {
                \par\nobreak\vspace{-.35ex}
                \noindent\scriptsize
                \textsc{\__sot_transport_word:}:\,#4
                \enspace\allowbreak
                \textsc{\__sot_source_word:}:\,
                  \__sot_query_value:nn {#8}{#5}
                \enspace\allowbreak
                \textsc{\__sot_transported_word:}:\,
                  \__sot_query_value:nn {#8}{#6}
                \enspace\allowbreak
                \textsc{\__sot_target_word:}:\,
                  \__sot_query_value:nn {#8}{#7}
                \par\vspace{.25ex}
              }
          }
        \hfil
        {\color{sotSecondOrder}\vrule width .65pt}
      }
  }

\cs_new:Npn \__sot_query_foot:nnnnnnnnn #1#2#3#4#5#6#7#8#9
  {
    \noindent\scriptsize
    \textbf{#1}\enspace
    \str_if_eq:VnF \l__sot_comp_disclosure_tl {compact}
      {
        \str_if_eq:VnTF \l__sot_comp_language_tl {pt-BR}
