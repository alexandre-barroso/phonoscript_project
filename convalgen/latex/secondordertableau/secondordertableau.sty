%% A rejected query contributes no visual or accessibility surface.  If it was
%% the only prospective second-order addition, validate the surrounding
%% container for an honest diagnostic, close the suspended tagging capture,
%% and emit no source-only figure that could be mistaken for the rejected
%% judgment.  Independently valid additions remain renderable.
\cs_new_protected:Npn \__sot_typeset_or_discard_composition:
  {
    \bool_if:NTF \l__sot_comp_had_invalid_query_bool
      {
        \seq_if_empty:NTF \l__sot_comp_query_seq
          {
            \seq_if_empty:NTF \l__sot_comp_change_seq
              {
                \seq_if_empty:NTF \l__sot_comp_map_seq
                  {\__sot_validate_composition:
                   \__sot_tag_capture_end:}
                  {\__sot_typeset_composition:}
              }
              {\__sot_typeset_composition:}
          }
          {\__sot_typeset_composition:}
      }
      {\__sot_typeset_composition:}
  }

\cs_new_protected:Npn \__sot_typeset_or_discard_judgment:
  {
    \bool_if:NTF \l__sot_comp_had_invalid_query_bool
      {
        \seq_if_empty:NTF \l__sot_comp_judgment_seq
          {\__sot_validate_judgment:
           \__sot_tag_capture_end:}
          {\__sot_typeset_judgment:}
      }
      {\__sot_typeset_judgment:}
  }

\cs_new_protected:Npn \__sot_typeset_or_discard_qcalculus:
  {
    \bool_if:NTF \l__sot_qcalc_valid_bool
      {\__sot_typeset_qcalculus:}
      {\__sot_tag_capture_end:}
  }

