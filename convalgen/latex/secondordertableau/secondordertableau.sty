\newcommand\qot@renderRegisteredLanes{%
  \qot@lanecount=0\relax
  \qot@lanes
  \ifnum\qot@lanecount<1\relax
    \PackageError{secondordertableau}%
      {The lanes key contains no registered qoverlaylane}%
      {Supply one or more explicit \string\qoverlaylane[...] commands.}%
  \fi
}

\NewDocumentEnvironment{qoverlay}{O{} +b}{%
  \qot@reset
  \pgfkeys{/qot/.cd,#1}%
  \qot@setlanguage
  \qot@validateEnvironment
  \qot@validateSourceBody{#2}%
  \ifdefstring{\qot@layout}{column}{%
    \ifdim\qot@width>88mm\setlength\qot@width{88mm}\fi
  }{%
    \ifdefstring{\qot@layout}{full}{}{%
      \PackageError{secondordertableau}{Unknown layout `\qot@layout'}%
        {Use full or column.}%
    }%
  }%
  \par\medskip\noindent
  \csname __sot_tag_capture_begin:\endcsname
  \csname __sot_tag_neutralize_accsupp:\endcsname
  \sbox\qot@outputbox{%
    \begin{minipage}{\qot@width}
      \raggedright
      \ifdefempty{\qot@title}{}{\textbf{\qot@title}\par\smallskip}%
      \small\textbf{\qot@sourceLabel:} \qot@sourcelocator\par
      \textbf{$T$:} \qot@transformation\par\smallskip
      \ifdefempty{\qot@lanes}{\qot@automaticLane}{\qot@renderRegisteredLanes}%
      \centering\qot@renderPanels{#2}
    \end{minipage}%
  }%
  \csname __sot_tag_capture_end:\endcsname
  \csname __sot_tag_emit_begin:nN\endcsname
    {\qot@alttext}\qot@outputbox
  \usebox\qot@outputbox
  \csname __sot_tag_emit_end:N\endcsname\qot@outputbox
  \par\medskip
}{ }

\NewDocumentCommand\qExpandedRequired{O{en}}{%
  \begingroup
  \def\qot@expandedlanguage{#1}%
  \def\qot@expandedtext{}%
  \ifdefstring{\qot@expandedlanguage}{en}{%
    \def\qot@expandedtext{EXPANDED PAIRED MODE REQUIRED}}{%
    \ifdefstring{\qot@expandedlanguage}{pt-BR}{%
      \def\qot@expandedtext{MODO PAREADO EXPANDIDO OBRIGAT\'ORIO}}{%
      \PackageError{secondordertableau}%
        {Unsupported language `\qot@expandedlanguage'}%
        {Use \string\qExpandedRequired[en] or \string\qExpandedRequired[pt-BR].}%
    }%
  }%
  \fbox{\strut\textbf{\qot@expandedtext}}%
  \endgroup
}

