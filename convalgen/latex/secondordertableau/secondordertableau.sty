\cs_new:Npn \__sot_form_text:nnn #1#2#3
  {
    %% The format can arrive as a table-level token-list variable (input) or
    %% as a literal captured with a row (candidate/fibre).  Resolve it before
    %% dispatch so mathematical forms never fall through as raw underscore
    %% text.  TIPA's T3 faces are Computer Modern; selecting that family
    %% explicitly avoids engine-dependent Latin-Modern substitution warnings
    %% without changing the surrounding point size.
    \tl_set:Nx \l_tmpa_tl {#2}
    \str_if_eq:VnT \l_tmpa_tl {inherit}
      {\tl_set_eq:NN \l_tmpa_tl \l__sot_form_format_tl}
    \str_case:VnF \l_tmpa_tl
      {
        {traditional}
          {\str_if_eq:nnTF {#1}{block}{\textit{#3}}{#3}}
        {input}{\textit{#3}}
        {plain}{#3}
        {smallcaps}{\textsc{#3}}
        {ipa}{{\fontencoding{T3}\fontfamily{cmr}\selectfont #3}}
        {math}{$#3$}
      }
      {#3}
  }

\cs_new_protected:Npn \__sot_sanitize_id:nN #1#2
  {
    \tl_set:Nn #2 {#1}
    \tl_trim_spaces:N #2
    \regex_replace_all:nnN { [^A-Za-z0-9]+ } { - } #2
    \regex_replace_once:nnN { \A-+ } {} #2
    \regex_replace_once:nnN { -+\Z } {} #2
    \tl_if_blank:VT #2
      {
        \bool_if:NTF \l__sot_query_preflight_bool
          {\__sot_query_error:nn
             {Identifier~`#1'~contains~no~usable~characters}
             {Use~letters,~digits,~spaces,~or~hyphens~in~semantic~identifiers.}}
          {\PackageError{secondordertableau}
             {Identifier~`#1'~contains~no~usable~characters}
             {Use~letters,~digits,~spaces,~or~hyphens~in~semantic~identifiers.}}
        \tl_set:Nn #2 { invalid }
      }
  }
\cs_generate_variant:Nn \__sot_sanitize_id:nN { VN }

\cs_new_protected:Npn \__sot_register_id:nnN #1#2#3
  {
    \tl_set:Nx \l_tmpb_tl {#2}
    \__sot_sanitize_id:VN \l_tmpb_tl #3
    \tl_set:Nx \l_tmpa_tl { #1 / \tl_use:N #3 }
    \prop_if_in:NVTF \l__sot_id_prop \l_tmpa_tl
      {
        \PackageError{secondordertableau}
          {Duplicate~#1~identifier~`#2'}
          {Every~referenced~#1~inside~one~sottableau~must~have~a~unique~id.}
      }
      {\prop_put:NVx \l__sot_id_prop \l_tmpa_tl {\tl_use:N \l_tmpb_tl}}
  }

\cs_new_protected:Npn \__sot_register_table_id:
  {
    \__sot_sanitize_id:VN
      \l__sot_table_id_tl \l__sot_table_id_safe_tl
    \prop_if_in:NVTF \g__sot_table_id_prop \l__sot_table_id_safe_tl
      {
        \PackageError{secondordertableau}
          {Duplicate~tableau~identifier~`\l__sot_table_id_tl'}
          {Give~each~explicitly~named~sottableau~a~document-unique~id.}
      }
      {
        \prop_gput:NVx \g__sot_table_id_prop \l__sot_table_id_safe_tl
          {\int_use:N \l__sot_table_serial_int}
      }
    \tl_gset_eq:NN \g__sot_last_table_id_tl \l__sot_table_id_safe_tl
  }

