\newcommand\qot@sourcePanel[1]{%
  \node[anchor=north west,draw=qotAccent,line width=.8pt,inner sep=5pt]
    (qotsource) at (0,0) {%
      \begin{minipage}{\qot@sourcewidth}
        \raggedright\scriptsize\textbf{\qot@sourceLabel}\par\smallskip
        \normalsize #1
      \end{minipage}%
    };%
}

\newcommand\qot@deltaPanel[1]{%
  \node[anchor=north west,draw=qotAccent,dashed,line width=.8pt,inner sep=5pt]
    (qotdelta) at #1 {%
      \begin{minipage}{\qot@auxwidth}
        \raggedright\scriptsize\textbf{$\Delta T$}\par\smallskip
        \normalsize\qot@delta
      \end{minipage}%
    };%
}

\newcommand\qot@targetPanel[1]{%
  \node[anchor=north west,draw=qotAccent,dashed,line width=.8pt,inner sep=5pt]
    (qottarget) at #1 {%
      \begin{minipage}{\qot@auxwidth}
        \raggedright\scriptsize\textbf{\qot@targetLabel}\par\smallskip
        \normalsize\qot@targetpanel
      \end{minipage}%
    };%
}

\newcommand\qot@renderPanels[1]{%
  \begin{tikzpicture}[baseline=(qotsource.north),font=\normalfont]
    \ifdefstring{\qot@mode}{overlay}{%
      \setlength\qot@sourcewidth{\dimexpr\qot@width-12pt\relax}%
      \qot@sourcePanel{#1}%
    }{%
      \ifdefstring{\qot@mode}{delta-sidecar}{%
        \ifdefstring{\qot@layout}{column}{%
          \setlength\qot@sourcewidth{\dimexpr\qot@width-12pt\relax}%
          \setlength\qot@auxwidth{\dimexpr\qot@width-12pt\relax}%
          \qot@sourcePanel{#1}%
          \qot@deltaPanel{([yshift=-7pt]qotsource.south west)}%
        }{%
          \setlength\qot@sourcewidth{.62\qot@width}%
          \setlength\qot@auxwidth{.27\qot@width}%
          \qot@sourcePanel{#1}%
          \qot@deltaPanel{([xshift=7pt]qotsource.north east)}%
        }%
      }{%
        \ifdefstring{\qot@mode}{paired}{%
          \ifdefstring{\qot@layout}{column}{%
            \setlength\qot@sourcewidth{\dimexpr\qot@width-12pt\relax}%
            \setlength\qot@auxwidth{\dimexpr\qot@width-12pt\relax}%
            \qot@sourcePanel{#1}%
            \node[anchor=north,font=\scriptsize,align=center]
              (qotspine) at ([yshift=-6pt]qotsource.south)
              {\textbf{\qot@transportLabel} $\downarrow$};%
            \coordinate (qottargetorigin) at
              ($(qotsource.west |- qotspine.south)+(0,-6pt)$);%
            \qot@targetPanel{(qottargetorigin)}%
          }{%
            \setlength\qot@sourcewidth{.36\qot@width}%
            \setlength\qot@auxwidth{.36\qot@width}%
            \qot@sourcePanel{#1}%
            \node[anchor=north west,font=\scriptsize,align=center]
              (qotspine) at ([xshift=7pt]qotsource.north east)
              {\textbf{\qot@transportLabel}\\[-1pt]$\longrightarrow$};%
            \qot@targetPanel{([xshift=7pt]qotspine.north east)}%
          }%
        }{}%
      }%
    }%
    \qot@annotations
  \end{tikzpicture}%
}

\newcommand\qot@automaticLane{%
  \qot@laneReset
  \let\qot@lanequeryid\qot@queryid
  \let\qot@lanequery\qot@query
  \let\qot@lanescope\qot@scope
  \let\qot@lanetransport\qot@transport
  \let\qot@laneformation\qot@formation
  \let\qot@laneadmission\qot@admission
  \let\qot@lanesource\qot@sourceanswer
  \let\qot@lanetransported\qot@transportedanswer
  \let\qot@lanetarget\qot@targetanswer
  \let\qot@laneverdict\qot@verdict
  \let\qot@lanewitness\qot@witness
  \let\qot@lanedependency\qot@dependency
  \let\qot@laneincidencekind\qot@incidencekind
  \let\qot@laneincidenceanchors\qot@incidenceanchors
  \let\qot@laneincidencedependencies\qot@incidencedependencies
  \let\qot@laneincidencenote\qot@incidencenote
  \qot@renderLane
}

\newcommand\qot@validateEnvironment{%
  \qot@require{\qot@sourcelocator}{source-locator}%
  \qot@require{\qot@transformation}{transformation}%
  \qot@require{\qot@alttext}{alt-text}%
  \ifdefstring{\qot@mode}{overlay}{%
    \qot@forbidModeKey{\qot@delta}{delta}{overlay}%
    \qot@forbidModeKey{\qot@targetpanel}{target-panel}{overlay}%
  }{%
    \ifdefstring{\qot@mode}{delta-sidecar}{%
      \qot@require{\qot@delta}{delta}%
      \qot@forbidModeKey{\qot@targetpanel}{target-panel}{delta-sidecar}%
    }{%
      \ifdefstring{\qot@mode}{paired}{%
        \qot@require{\qot@targetpanel}{target-panel}%
        \qot@forbidModeKey{\qot@delta}{delta}{paired}%
      }{%
        \PackageError{secondordertableau}{Unknown mode `\qot@mode'}%
          {Use overlay, delta-sidecar, or paired.}%
      }%
    }%
  }%
  \ifdefempty{\qot@lanes}{}{\qot@validateExplicitLanes}%
}

