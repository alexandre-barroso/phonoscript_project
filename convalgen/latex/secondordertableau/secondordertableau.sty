    \tl_clear:N \l__sot_qstep_certificate_tl
    \tl_clear:N \l__sot_qstep_card_id_tl
    \tl_clear:N \l__sot_qstep_authority_tl
    \tl_clear:N \l__sot_qstep_digest_tl
    \tl_clear:N \l__sot_qstep_note_tl
