\newcommand\qot@sort[1]{%
  \ifqot@portuguese
    \def\qot@translated{#1}%
    \ifdefstring{#1}{WIN}{\def\qot@translated{VENCEDOR}}{}%
    \ifdefstring{#1}{ORDER}{\def\qot@translated{ORDEM}}{}%
    \ifdefstring{#1}{MARGIN}{\def\qot@translated{MARGEM}}{}%
    \ifdefstring{#1}{PROBABILITY}{\def\qot@translated{PROBABILIDADE}}{}%
    \ifdefstring{#1}{TRACE}{\def\qot@translated{TRAJET\'ORIA}}{}%
    \ifdefstring{#1}{TERMINAL}{\def\qot@translated{TERMINAL}}{}%
    \ifdefstring{#1}{SUPPORT}{\def\qot@translated{SUPORTE}}{}%
    \ifdefstring{#1}{REALIZATION}{\def\qot@translated{REALIZA\c C\~AO}}{}%
    \ifdefstring{#1}{EVIDENCE}{\def\qot@translated{EVID\^ENCIA}}{}%
    \qot@translated
  \else #1\fi
}

\newcommand\qot@printscope[1]{%
  \ifqot@portuguese
    \def\qot@translated{#1}%
    \ifdefstring{#1}{winner only}{\def\qot@translated{APENAS VENCEDOR}}{}%
    \ifdefstring{#1}{complete order}{\def\qot@translated{ORDEM COMPLETA}}{}%
    \ifdefstring{#1}{probability law}{\def\qot@translated{LEI DE PROBABILIDADE}}{}%
    \ifdefstring{#1}{trace}{\def\qot@translated{TRAJET\'ORIA DERIVACIONAL}}{}%
    \ifdefstring{#1}{terminal only}{\def\qot@translated{APENAS TERMINAL}}{}%
    \ifdefstring{#1}{observation only}{\def\qot@translated{APENAS OBSERVA\c C\~AO}}{}%
    \qot@translated
  \else \MakeUppercase{#1}\fi
}

\newcommand\qot@printtransport[1]{%
  \def\qot@translated{#1}%
  \ifqot@portuguese
    \ifdefstring{#1}{IDENTITY}{\def\qot@translated{\qot@identity}}{}%
  \fi
  \qot@translated
}

\newcommand\qot@printverdict[1]{%
  \ifdefstring{#1}{conservative}{\qot@conservative}{%
    \ifdefstring{#1}{nonconservative}{\qot@nonconservative}{\qot@notEvaluated}}%
}

\newcommand\qot@printformation[1]{%
  \ifqot@portuguese
    \ifdefstring{#1}{formed}{FORMADA}{N\~AO FORMADA}%
  \else \MakeUppercase{#1}\fi
}

\newcommand\qot@printadmission[1]{%
  \ifqot@portuguese
    \ifdefstring{#1}{admitted}{ADMITIDA}{N\~AO ADMITIDA}%
  \else \MakeUppercase{#1}\fi
}

\newcommand\qot@printincidencekind[1]{%
  \ifqot@portuguese
    \ifdefstring{#1}{local}{LOCAL}{%
      \ifdefstring{#1}{global}{GLOBAL}{%
        \ifdefstring{#1}{terminal}{TERMINAL}{%
          \ifdefstring{#1}{trace}{TRAJET\'ORIA}{%
            \ifdefstring{#1}{carrier}{PORTADOR}{%
              \ifdefstring{#1}{layer}{CAMADA}{\MakeUppercase{#1}}}}}}}%
  \else \MakeUppercase{#1}\fi
}

