\cs_new_protected:Npn \__sot_reserve_incidence_extent:nn #1#2
  {
    %% Overlay marks do not contribute to a TeX box by themselves.  Reserve
    %% their complete lane plus label/tick allowance so a clean log can never
    %% conceal a mark clipped at the physical page edge.
    \dim_set:Nn \l_tmpa_dim {11pt*#1-7.8pt+14pt}
    %% The incidence query identifier is itself visible ink.  Measure it
    %% rather than reserving only the lane and tick, so arbitrarily meaningful
    %% author labels remain inside the TeX box and tagged Figure /BBox.
    \hbox_set:Nn \l_tmpa_box {\tiny \l__sot_query_label_tl}
    \dim_add:Nn \l_tmpa_dim {\box_wd:N \l_tmpa_box + 4pt}
    %% A refused query prints its exact failed dependency beside the physical
    %% break.  Reserve a small wrapping column; long prose remains repeated in
    %% the query rail and may wrap there without enlarging this annotation.
    \str_if_eq:VnT \l__sot_query_result_tl {not-evaluated}
      {\dim_add:Nn \l_tmpa_dim {58pt}}
    \str_case:nnF {#2}
      {
        {terminal}
          {\dim_set:Nn \l__sot_comp_right_pad_dim
             {\dim_max:nn {\l__sot_comp_right_pad_dim}{\l_tmpa_dim}}}
        {carrier}
          {\str_if_eq:VnT \l__sot_query_result_tl {not-evaluated}
             {\dim_set:Nn \l__sot_comp_left_pad_dim
                {\dim_max:nn
                   {\l__sot_comp_left_pad_dim}{\l_tmpa_dim}}}}
      }
      {\dim_set:Nn \l__sot_comp_left_pad_dim
         {\dim_max:nn {\l__sot_comp_left_pad_dim}{\l_tmpa_dim}}}
  }

