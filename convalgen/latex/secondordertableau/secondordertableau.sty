\cs_new_protected:Npn \__sot_resolve_query_profile:
  {
    \tl_if_blank:VF \l__sot_query_profile_tl
      {
        \str_case:VnF \l__sot_query_profile_tl
          {
            {winner}{\__sot_query_profile_values:nnnn {WIN}{local}
              {winner~preservation~only;~not~complete~order,~margin,~or~probability}
              {somente~preservação~do~vencedor;~não~ordem~completa,~margem~ou~probabilidade}}
            {co-winner}{\__sot_query_profile_values:nnnn {WIN}{local}
              {co-winner-set~preservation~only;~not~complete~order,~margin,~or~probability}
              {somente~preservação~do~conjunto~de~covencedores;~não~ordem~completa,~margem~ou~probabilidade}}
            {order}{\__sot_query_profile_values:nnnn {ORDER}{global}
              {complete~candidate~order~only;~not~margin~or~probability}
              {somente~ordem~completa~dos~candidatos;~não~margem~ou~probabilidade}}
            {margin}{\__sot_query_profile_values:nnnn {MARGIN}{local}
              {registered~margin~only;~not~a~probability~law}
              {somente~a~margem~registrada;~não~uma~lei~de~probabilidade}}
            {candidate-probability}
              {\__sot_query_profile_values:nnnn {PROBABILITY}{global}
                {registered~candidate~probability~only;~not~a~category~or~whole-law~claim}
                {somente~a~probabilidade~registrada~do~candidato;~não~uma~afirmação~categorial~ou~da~lei~completa}}
            {category-probability}
              {\__sot_query_profile_values:nnnn {PROBABILITY}{global}
                {registered~category~probability~only;~not~a~candidate-level~law}
                {somente~a~probabilidade~registrada~da~categoria;~não~uma~lei~no~nível~dos~candidatos}}
            {terminal-output}
              {\__sot_query_profile_values:nnnn {TERMINAL}{terminal}
                {registered~terminal~output~only;~not~the~trace~or~stopping~behavior}
                {somente~a~saída~terminal~registrada;~não~a~trajetória~ou~o~comportamento~de~parada}}
            {trace}{\__sot_query_profile_values:nnnn {TRACE}{trace}
              {complete~registered~trace~only;~not~broader~serial~dynamics}
              {somente~a~trajetória~registrada~completa;~não~a~dinâmica~serial~mais~ampla}}
            {stopping}{\__sot_query_profile_values:nnnn {TRACE}{trace}
              {registered~stopping~behavior~only}
              {somente~o~comportamento~de~parada~registrado}}
            {nontermination}{\__sot_query_profile_values:nnnn {TRACE}{trace}
              {registered~nontermination~behavior~only}
              {somente~o~comportamento~de~não~terminação~registrado}}
            {positive-support}
              {\__sot_query_profile_values:nnnn {SUPPORT}{carrier}
                {exact~positive~support~on~the~registered~carrier~only}
                {somente~o~suporte~positivo~exato~no~portador~registrado}}
            {threshold}{\__sot_query_profile_values:nnnn {SUPPORT}{carrier}
              {registered~threshold~crossing~only}
              {somente~o~cruzamento~do~limiar~registrado}}
            {realization}
              {\__sot_query_profile_values:nnnn {REALIZATION}{layer}
                {registered~realization~only;~not~grammar~or~observation}
                {somente~a~realização~registrada;~não~a~gramática~ou~a~observação}}
            {observation}
              {\__sot_query_profile_values:nnnn {EVIDENCE}{layer}
                {registered~observation~only;~not~a~grammatical~representation}
                {somente~a~observação~registrada;~não~uma~representação~gramatical}}
            {evidential-decision}
              {\__sot_query_profile_values:nnnn {EVIDENCE}{global}
                {registered~evidential~decision~only;~not~grammar~equivalence~or~empirical~adequacy}
                {somente~a~decisão~evidencial~registrada;~não~equivalência~gramatical~ou~adequação~empírica}}
          }
          {
            \__sot_query_error:nn
              {Unknown~query~profile~`\l__sot_query_profile_tl'}
              {Use~a~documented~profile,~or~omit~profile~and~declare~answer~and~incidence~directly.}
          }
      }
  }

