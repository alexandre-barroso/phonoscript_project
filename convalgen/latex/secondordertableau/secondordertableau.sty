\newcommand\qot@require[2]{%
  \ifdefempty{#1}{%
    \PackageError{secondordertableau}{Required key `#2' is absent}%
      {Supply `#2' explicitly; the package does not infer comparison content.}%
  }{}%
}

\newcommand\qot@forbid[2]{%
  \ifdefempty{#1}{}{%
    \PackageError{secondordertableau}{Key `#2' is incompatible with the declared verdict}%
      {Remove `#2' or correct the verdict and formation/admission statuses.}%
  }%
}

\newcommand\qot@forbidModeKey[3]{%
  \ifdefempty{#1}{}{%
    \PackageError{secondordertableau}{Key `#2' is incompatible with mode=#3}%
      {Remove `#2' or select the mode that owns that panel key.}%
  }%
}

\newcommand\qot@forbidTopLevelLaneKey[2]{%
  \ifdefempty{#1}{}{%
    \PackageError{secondordertableau}{Top-level lane key `#2' cannot accompany `lanes'}%
      {Move `#2' into each intended \string\qoverlaylane; explicit lanes never inherit top-level lane fields.}%
  }%
}

\newcommand\qot@validateExplicitLanes{%
  \qot@forbidTopLevelLaneKey{\qot@queryid}{query-id}%
  \qot@forbidTopLevelLaneKey{\qot@query}{query}%
  \qot@forbidTopLevelLaneKey{\qot@scope}{scope}%
  \qot@forbidTopLevelLaneKey{\qot@transport}{transport}%
  \qot@forbidTopLevelLaneKey{\qot@formation}{formation-status}%
  \qot@forbidTopLevelLaneKey{\qot@admission}{admission-status}%
  \qot@forbidTopLevelLaneKey{\qot@sourceanswer}{source-answer}%
  \qot@forbidTopLevelLaneKey{\qot@transportedanswer}{transported-source-answer}%
  \qot@forbidTopLevelLaneKey{\qot@targetanswer}{target-answer}%
  \qot@forbidTopLevelLaneKey{\qot@verdict}{verdict}%
  \qot@forbidTopLevelLaneKey{\qot@witness}{witness}%
  \qot@forbidTopLevelLaneKey{\qot@dependency}{dependency}%
  \qot@forbidTopLevelLaneKey{\qot@incidencekind}{incidence-kind}%
  \qot@forbidTopLevelLaneKey{\qot@incidenceanchors}{incidence-anchors}%
  \qot@forbidTopLevelLaneKey{\qot@incidencedependencies}{incidence-dependencies}%
  \qot@forbidTopLevelLaneKey{\qot@incidencenote}{incidence-note}%
}

\newcommand\qot@validateIncidence{%
  \qot@require{\qot@laneincidencekind}{incidence-kind}%
  \qot@require{\qot@laneincidenceanchors}{incidence-anchors}%
  \qot@require{\qot@laneincidencedependencies}{incidence-dependencies}%
  \ifdefstring{\qot@laneincidencekind}{local}{}{%
    \ifdefstring{\qot@laneincidencekind}{global}{}{%
      \ifdefstring{\qot@laneincidencekind}{terminal}{}{%
        \ifdefstring{\qot@laneincidencekind}{trace}{}{%
          \ifdefstring{\qot@laneincidencekind}{carrier}{}{%
            \ifdefstring{\qot@laneincidencekind}{layer}{}{%
              \PackageError{secondordertableau}{Unknown incidence-kind `\qot@laneincidencekind'}%
                {Use local, global, terminal, trace, carrier, or layer.}%
            }%
          }%
        }%
      }%
    }%
  }%
}

\newcommand\qot@registerQueryId{%
  \xifinlist{\qot@lanequeryid}{\qot@seenqueryids}{%
    \PackageError{secondordertableau}{Duplicate query-id `\qot@lanequeryid'}%
      {Every stacked query lane requires a unique stable query-id.}%
  }{%
    \listxadd{\qot@seenqueryids}{\qot@lanequeryid}%
  }%
}

\newcommand\qot@validateSortIncidence{%
  \ifdefstring{\qot@lanequery}{TRACE}{%
    \ifdefstring{\qot@laneincidencekind}{trace}{}{%
      \PackageError{secondordertableau}%
        {TRACE requires incidence-kind=trace}%
        {A TRACE answer spans every registered derivational stage.}%
    }%
  }{%
    \ifdefstring{\qot@laneincidencekind}{trace}{%
      \PackageError{secondordertableau}%
        {incidence-kind=trace requires query=TRACE}%
        {Use the TRACE answer sort or select the incidence kind licensed by Q.}%
    }{}%
  }%
  \ifdefstring{\qot@lanequery}{TERMINAL}{%
    \ifdefstring{\qot@laneincidencekind}{terminal}{}{%
      \PackageError{secondordertableau}%
        {TERMINAL requires incidence-kind=terminal}%
        {A TERMINAL answer spans only the registered final readout.}%
    }%
  }{%
    \ifdefstring{\qot@laneincidencekind}{terminal}{%
      \PackageError{secondordertableau}%
        {incidence-kind=terminal requires query=TERMINAL}%
        {Use the TERMINAL answer sort or select the incidence kind licensed by Q.}%
    }{}%
  }%
  \ifdefstring{\qot@lanequery}{PROBABILITY}{%
    \ifdefstring{\qot@laneincidencekind}{global}{}{%
      \PackageError{secondordertableau}%
        {PROBABILITY requires incidence-kind=global}%
        {Probability answers include the complete relevant support and normalizer.}%
    }%
  }{}%
}

\newcommand\qot@validateAdmitted{%
  \ifdefstring{\qot@laneformation}{formed}{}{%
    \PackageError{secondordertableau}{An admitted verdict requires formation-status=formed}%
      {Correct the status or use verdict=not evaluated.}%
  }%
  \ifdefstring{\qot@laneadmission}{admitted}{}{%
    \PackageError{secondordertableau}{An admitted verdict requires admission-status=admitted}%
      {Correct the status or use verdict=not evaluated.}%
  }%
  \qot@require{\qot@lanesource}{source-answer}%
  \qot@require{\qot@lanetransported}{transported-source-answer}%
  \qot@require{\qot@lanetarget}{target-answer}%
  \qot@forbid{\qot@lanedependency}{dependency}%
}

\newcommand\qot@validateStatuses{%
  \ifdefstring{\qot@laneformation}{formed}{}{%
    \ifdefstring{\qot@laneformation}{not-formed}{}{%
      \PackageError{secondordertableau}%
        {Unknown formation-status `\qot@laneformation'}%
        {Use formed or not-formed.}%
    }%
  }%
  \ifdefstring{\qot@laneadmission}{admitted}{}{%
    \ifdefstring{\qot@laneadmission}{not-admitted}{}{%
      \PackageError{secondordertableau}%
        {Unknown admission-status `\qot@laneadmission'}%
        {Use admitted or not-admitted.}%
    }%
  }%
  \ifdefstring{\qot@laneformation}{not-formed}{%
    \ifdefstring{\qot@laneadmission}{not-admitted}{}{%
      \PackageError{secondordertableau}%
        {An unformed query cannot be admitted}%
        {Use admission-status=not-admitted.}%
    }%
  }{}%
}

\newcommand\qot@validateQuerySort{%
  \qot@statusvalidfalse
  \ifdefstring{\qot@lanequery}{WIN}{\qot@statusvalidtrue}{}%
  \ifdefstring{\qot@lanequery}{ORDER}{\qot@statusvalidtrue}{}%
  \ifdefstring{\qot@lanequery}{MARGIN}{\qot@statusvalidtrue}{}%
  \ifdefstring{\qot@lanequery}{PROBABILITY}{\qot@statusvalidtrue}{}%
  \ifdefstring{\qot@lanequery}{TRACE}{\qot@statusvalidtrue}{}%
  \ifdefstring{\qot@lanequery}{TERMINAL}{\qot@statusvalidtrue}{}%
  \ifdefstring{\qot@lanequery}{SUPPORT}{\qot@statusvalidtrue}{}%
  \ifdefstring{\qot@lanequery}{REALIZATION}{\qot@statusvalidtrue}{}%
  \ifdefstring{\qot@lanequery}{EVIDENCE}{\qot@statusvalidtrue}{}%
  \ifqot@statusvalid\else
    \PackageError{secondordertableau}%
      {Unknown query answer sort `\qot@lanequery'}%
      {Use WIN, ORDER, MARGIN, PROBABILITY, TRACE, TERMINAL, SUPPORT,
       REALIZATION, or EVIDENCE.}%
  \fi
}

\newcommand\qot@validateRefusal{%
  \ifdefstring{\qot@laneadmission}{not-admitted}{}{%
    \PackageError{secondordertableau}%
      {NOT EVALUATED requires admission-status=not-admitted}%
      {Correct the status or use an admitted verdict.}%
  }%
  \qot@require{\qot@lanesource}{source-answer}%
  \qot@require{\qot@lanetransported}{transported-source-answer}%
  \qot@require{\qot@lanetarget}{target-answer}%
  \qot@require{\qot@lanedependency}{dependency}%
  \qot@forbid{\qot@lanewitness}{witness}%
}

\newcommand\qot@validateLane{%
  \qot@require{\qot@lanequeryid}{query-id}%
  \qot@require{\qot@lanequery}{query}%
  \qot@require{\qot@lanescope}{scope}%
  \qot@require{\qot@lanetransport}{transport}%
  \qot@require{\qot@laneformation}{formation-status}%
  \qot@require{\qot@laneadmission}{admission-status}%
  \qot@require{\qot@laneverdict}{verdict}%
  \qot@validateQuerySort
  \qot@validateStatuses
  \qot@validateIncidence
  \qot@validateSortIncidence
  \ifdefstring{\qot@laneverdict}{conservative}{%
    \qot@validateAdmitted
    \qot@forbid{\qot@lanewitness}{witness}%
  }{%
    \ifdefstring{\qot@laneverdict}{nonconservative}{%
      \qot@validateAdmitted
      \qot@require{\qot@lanewitness}{witness}%
    }{%
      \ifdefstring{\qot@laneverdict}{not evaluated}{\qot@validateRefusal}{%
        \PackageError{secondordertableau}{Unknown verdict `\qot@laneverdict'}%
          {Use conservative, nonconservative, or not evaluated.}%
      }%
    }%
  }%
}

\newcommand\qot@normalIncidence{%
  \noindent\textcolor{qotAccent}{%
    \ifdefstring{\qot@laneincidencekind}{local}{%
      \rule{.18\linewidth}{.8pt}\hspace{.025\linewidth}\rule{.12\linewidth}{.8pt}%
    }{%
      \ifdefstring{\qot@laneincidencekind}{global}{%
        \rule{.42\linewidth}{.8pt}\hspace{.03\linewidth}\rule{.42\linewidth}{.8pt}%
      }{%
        \ifdefstring{\qot@laneincidencekind}{terminal}{%
          \hfill\rule{.24\linewidth}{1.1pt}%
        }{%
          \ifdefstring{\qot@laneincidencekind}{trace}{%
            \rule{.18\linewidth}{.8pt}\hspace{.025\linewidth}%
            \rule{.18\linewidth}{.8pt}\hspace{.025\linewidth}%
            \rule{.18\linewidth}{.8pt}\hspace{.025\linewidth}%
            \rule{.18\linewidth}{.8pt}%
          }{%
            \ifdefstring{\qot@laneincidencekind}{carrier}{%
              \begin{tikzpicture}[x=\linewidth,y=1ex,baseline={(0,0)}]
                \draw[line width=.8pt,color=qotAccent]
                  (0,-.55)--(0,.45)--(.9,.45)--(.9,-.55);
                \foreach \x in {.225,.45,.675}
                  \draw[line width=.8pt,color=qotAccent] (\x,.45)--(\x,-.15);
              \end{tikzpicture}%
            }{%
              \ifdefstring{\qot@laneincidencekind}{layer}{%
                \begin{tikzpicture}[x=\linewidth,y=1ex,baseline={(0,0)}]
                  \draw[line width=.8pt,color=qotAccent]
                    (0,.45)--(.40,.45)--(.47,-.45)--(.56,-.45)--(.63,.45)--(.9,.45);
                  \draw[line width=.8pt,color=qotAccent]
                    (.43,.9)--(.47,.45)--(.52,.9);
                \end{tikzpicture}%
              }{}%
            }%
          }%
        }%
      }%
    }%
  }%
}

\newcommand\qot@stoppedIncidence{%
  \noindent\textcolor{qotAccent}{%
    \ifdefstring{\qot@laneincidencekind}{local}{\rule{.18\linewidth}{.8pt}}{%
      \ifdefstring{\qot@laneincidencekind}{global}{\rule{.44\linewidth}{.8pt}}{%
        \ifdefstring{\qot@laneincidencekind}{terminal}{\hfill\rule{.14\linewidth}{1.1pt}}{%
          \ifdefstring{\qot@laneincidencekind}{trace}{%
            \rule{.18\linewidth}{.8pt}\hspace{.025\linewidth}\rule{.18\linewidth}{.8pt}%
          }{%
            \ifdefstring{\qot@laneincidencekind}{carrier}{%
              \begin{tikzpicture}[x=\linewidth,y=1ex,baseline={(0,0)}]
                \draw[line width=.8pt,color=qotAccent]
                  (0,-.55)--(0,.45)--(.58,.45)--(.58,-.55);
                \foreach \x in {.145,.29,.435}
                  \draw[line width=.8pt,color=qotAccent] (\x,.45)--(\x,-.15);
              \end{tikzpicture}%
            }{%
              \ifdefstring{\qot@laneincidencekind}{layer}{%
                \begin{tikzpicture}[x=\linewidth,y=1ex,baseline={(0,0)}]
                  \draw[line width=.8pt,color=qotAccent]
                    (0,.45)--(.23,.45)--(.30,-.45)--(.39,-.45)--(.46,.45)--(.58,.45);
                  \draw[line width=.8pt,color=qotAccent]
                    (.26,.9)--(.30,.45)--(.35,.9);
                \end{tikzpicture}%
              }{}%
            }%
          }%
        }%
      }%
    }%
    \hspace{3pt}\raisebox{-.45ex}{\rule{1pt}{1.9ex}}%
  }%
}

\newcommand\qot@renderIncidence{%
  \par\smallskip\scriptsize
  \textbf{\qot@incidenceLabel--\qot@printincidencekind{\qot@laneincidencekind}:}
  \qot@laneincidenceanchors\par
  \textbf{\qot@dependenciesLabel:} \qot@laneincidencedependencies
  \ifdefempty{\qot@laneincidencenote}{}{\par\qot@laneincidencenote}%
  \par\smallskip
  \ifdefstring{\qot@laneverdict}{not evaluated}{\qot@stoppedIncidence}{\qot@normalIncidence}%
}

\newcommand\qot@renderAvailableAnswers{%
  \ifdefempty{\qot@lanesource}{}{%
    \par\textsc{\qot@sourceAnswerLabel}: \qot@lanesource}%
  \ifdefempty{\qot@lanetransported}{}{%
    \par\textsc{\qot@transportedAnswerLabel}: \qot@lanetransported}%
  \ifdefempty{\qot@lanetarget}{}{%
    \par\textsc{\qot@targetAnswerLabel}: \qot@lanetarget}%
}

\newcommand\qot@renderLane{%
  \qot@validateLane
  \qot@registerQueryId
  \par\smallskip
  \noindent\begin{minipage}{\linewidth}
    \raggedright
    \textbf{\qot@lanequeryid[\qot@sort{\qot@lanequery}%
      \qot@queryseparator\qot@printscope{\qot@lanescope}]}\par
    \scriptsize
    \textbf{\qot@formationLabel:} \qot@printformation{\qot@laneformation}\quad
    \textbf{\qot@admissionLabel:} \qot@printadmission{\qot@laneadmission}\par
    \textbf{\qot@transportLabel:} \qot@printtransport{\qot@lanetransport}
    \qot@renderIncidence
    \qot@renderAvailableAnswers
    \ifdefstring{\qot@laneverdict}{not evaluated}{%
      \par\smallskip
      \ifdefstring{\qot@layout}{column}{\scriptsize}{\normalsize}%
      \textbf{\qot@notEvaluated: \qot@lanedependency}\par\smallskip
      \fbox{\strut\textbf{\qot@scopeLabel: \qot@printscope{\qot@lanescope}}}%
    }{%
      \ifdefempty{\qot@lanewitness}{}{%
        \par\smallskip
        \ifdefstring{\qot@layout}{column}{\scriptsize}{\normalsize}%
        \textbf{\qot@witnessLabel:} \qot@lanewitness}%
      \par\smallskip
      \ifdefstring{\qot@layout}{column}{\scriptsize}{\normalsize}%
      \fbox{\strut\textbf{\qot@printverdict{\qot@laneverdict}}}%
      \ifdefstring{\qot@layout}{column}{\par\smallskip}{\quad}%
      \fbox{\strut\textbf{\qot@scopeLabel: \qot@printscope{\qot@lanescope}}}%
    }%
  \end{minipage}\par\smallskip
}

\NewDocumentCommand\qoverlaylane{O{}}{%
  \advance\qot@lanecount by 1\relax
  \qot@laneReset
  \pgfkeys{/qot/lane/.cd,#1}%
  \qot@renderLane
}

