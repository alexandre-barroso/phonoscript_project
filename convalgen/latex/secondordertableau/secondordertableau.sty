%% Tagged-PDF lifecycle for every public visual surface.  Auto-taggable
%% tables and TikZ internals are constructed while tagging is suspended, then
%% the complete placed surface is exposed as one Figure marked-content item.
%% Audit disclosure remains ordinary reflowable tagged text outside Figure.
\cs_new_protected:Npn \__sot_tag_capture_begin:
  {
    \bool_set_false:N \l__sot_tag_capture_bool
    \cs_if_exist:NT \tag_if_active:T
      {
        \tag_if_active:T
          {
            \bool_set_true:N \l__sot_tag_capture_bool
            \tag_suspend:n { secondordertableau/capture }
          }
      }
  }

\cs_new_protected:Npn \__sot_tag_capture_end:
  {
    \bool_if:NT \l__sot_tag_capture_bool
      { \tag_resume:n { secondordertableau/capture } }
  }

\cs_new_protected:Npn \__sot_tag_neutralize_accsupp:
  {
    \bool_if:NT \l__sot_tag_capture_bool
      {\cs_if_exist:NT \BeginAccSupp
        {
          \cs_set_eq:NN \BeginAccSupp \use_none:n
          \cs_set_eq:NN \EndAccSupp \use_none:n
        }}
  }

\cs_new_protected:Npn \__sot_tag_emit_begin:nN #1#2
  {
    \bool_set_false:N \l__sot_tag_figure_bool
    \bool_set_false:N \l__sot_tag_paragraph_bool
    \bool_if:NT \l__sot_tag_capture_bool
      {
        \bool_set_true:N \l__sot_tag_figure_bool
        \int_gincr:N \g__sot_tag_figure_int
        \tl_set:Ne \l__sot_tag_figure_label_tl
          { sot-figure-\int_use:N \g__sot_tag_figure_int }
        \tl_set:Ne \l__sot_tag_alt_tl { \text_purify:n {#1} }
        %% A Figure emitted in vertical mode must begin the surrounding
        %% tagged paragraph through LaTeX's paragraph socket.  A bare
        %% \noindent enters horizontal mode visually, but leaves the PDF
        %% management layer expecting a paragraph MC that was never opened.
        \mode_if_vertical:T
          {
            \cs_if_exist:NTF \tag_socket_use:n
              {\tag_socket_use:n { para/begin }
               \bool_set_true:N \l__sot_tag_paragraph_bool}
              {\noindent}
          }
        \tag_mc_end_push:
        \tag_struct_begin:n { tag=Figure, alt={\l__sot_tag_alt_tl} }
        \tl_set:Ne \l__sot_tag_struct_num_tl
          { \tag_get:n { struct_num } }
        \tag_mc_begin:n { tag=Figure }
        \tag_mc_reset_box:N #2
        \tex_savepos:D
        \property_record:ee
          { \l__sot_tag_figure_label_tl } { xpos,ypos,abspage }
        \tex_savepos:D
      }
  }

\cs_new_protected:Npn \__sot_tag_emit_end:N #1
  {
    \bool_if:NT \l__sot_tag_figure_bool
      {
        %% The two-point pad encloses antialiased edge pixels and every
        %% package-owned overlay, whose complete surface was captured above.
        %% A deliberately external user overlay is outside this Figure.
        \tag_struct_gput:ene { \l__sot_tag_struct_num_tl } { attribute }
          {
            /O~/Layout~/BBox~[
              \dim_to_decimal_in_bp:n
                {
                  \property_ref:een
                    { \l__sot_tag_figure_label_tl } { xpos } { 0 } sp
                  - 2pt
                }
              \c_space_tl
              \dim_to_decimal_in_bp:n
                {
                  \property_ref:een
                    { \l__sot_tag_figure_label_tl } { ypos } { 0 } sp
                  - \box_dp:N #1 - 2pt
                }
              \c_space_tl
