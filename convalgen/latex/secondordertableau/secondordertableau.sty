\cs_new_protected:Npn \__sot_build_core:
  {
    \str_case:VnF \l__sot_comp_resolved_mode_tl
      {
        {overlay}
          {\hbox_set:Nn \l__sot_comp_core_box
             {\box_use:N \g__sot_comp_source_box}}
        {delta-sidecar}
          {
            \__sot_build_sidecar:
            \hbox_set:Nn \l__sot_comp_core_box
              {
                \vtop{\vskip0pt\box_use:N \g__sot_comp_source_box}
                \hskip .75em
                {\color{sotSecondOrder}
                 \vrule width \g__sot_comp_source_rule_dim}
                \hskip .75em
                \rlap{\__sot_comp_mark:nnn {sidecar}{sidecar}{\strut}}
                \vtop{\vskip0pt\box_use:N \l__sot_comp_sidecar_box}
              }
          }
        {paired}
          {
            \__sot_build_spine:
            \dim_set:Nn \l_tmpa_dim
              {\box_wd:N \g__sot_comp_source_box
               +\box_wd:N \g__sot_comp_target_box
               +\box_wd:N \l__sot_comp_spine_box
               +2\l__sot_comp_gap_dim}
            \bool_set_false:N \l_tmpa_bool
            \str_if_eq:VnT \l__sot_comp_layout_tl {vertical}
              {\bool_set_true:N \l_tmpa_bool}
            \str_if_eq:VnT \l__sot_comp_layout_tl {auto}
              {\dim_compare:nNnT {\l_tmpa_dim}>{\linewidth}
                 {\bool_set_true:N \l_tmpa_bool}}
            \bool_if:NTF \l_tmpa_bool
              {
                \dim_set:Nn \l_tmpb_dim
                  {\dim_max:nn {\box_wd:N \g__sot_comp_source_box}
                    {\box_wd:N \g__sot_comp_target_box}}
                \vbox_set:Nn \l__sot_comp_core_box
                  {
                    \hbox_to_wd:nn {\l_tmpb_dim}
                      {\hfil\box_use:N \g__sot_comp_source_box\hfil}
                    \vskip .65ex
                    \hbox_to_wd:nn {\l_tmpb_dim}
                      {\hfil\scriptsize\bfseries
                       \str_if_eq:VnTF \l__sot_comp_language_tl {pt-BR}
                         {TRANSPORTE}{TRANSPORT}\enspace$\downarrow$\hfil}
                    \vskip .65ex
                    \hbox_to_wd:nn {\l_tmpb_dim}
                      {\hfil\box_use:N \g__sot_comp_target_box\hfil}
                  }
              }
              {
                \hbox_set:Nn \l__sot_comp_core_box
                  {
                    \vtop{\vskip0pt\box_use:N \g__sot_comp_source_box}
                    \hskip \l__sot_comp_gap_dim
                    \vtop{\vskip0pt\box_use:N \l__sot_comp_spine_box}
                    \hskip \l__sot_comp_gap_dim
                    \vtop{\vskip0pt\box_use:N \g__sot_comp_target_box}
                  }
              }
          }
      }
      {}
    %% A one-constraint OT tableau can be narrower than a complete query
    %% sentence.  The source grid itself is never scaled or widened; only the
    %% added rail receives a modest publication-safe minimum measure.
    \dim_set:Nn \l__sot_comp_width_dim
      {\dim_max:nn {\box_wd:N \l__sot_comp_core_box}{24em}}
    \dim_set:Nn \l__sot_comp_outer_width_dim
      {\l__sot_comp_left_pad_dim + \l__sot_comp_width_dim
       + \l__sot_comp_right_pad_dim}
  }

