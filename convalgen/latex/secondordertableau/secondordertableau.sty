\cs_new_protected:Npn \__sot_resolve_source_anchor:nN #1#2
  {
    \bool_set_false:N \l__sot_resolved_anchor_inner_bool
    \bool_set_false:N \l__sot_resolved_anchor_cell_bool
    \bool_set_false:N \l__sot_resolved_anchor_boundary_bool
    \tl_set:Nn \l__sot_selector_value_tl {#1}
    \tl_trim_spaces:N \l__sot_selector_value_tl
    \str_case:VnF \l__sot_selector_value_tl
      {
        {grid}
          {\tl_set:Nx #2
             {sot-\int_use:N \g__sot_comp_source_serial_int-grid-grid}}
        {input}
          {
            \bool_set_true:N \l__sot_resolved_anchor_inner_bool
            \bool_if:NTF \g__sot_comp_source_external_bool
              {
                \prop_if_in:NnTF \g__sot_comp_source_ids_prop {special/input}
                  {\tl_set:Nx #2
                     {sot-\int_use:N \g__sot_comp_source_serial_int-input-input}}
                  {\__sot_selector_error:n {#1}
                   \tl_set:Nx #2
                     {sot-\int_use:N \g__sot_comp_source_serial_int-grid-grid}}
              }
              {\tl_set:Nx #2
                 {sot-\int_use:N \g__sot_comp_source_serial_int-input-input}}
          }
        {normalizer}
          {
            \prop_if_in:NnTF \g__sot_comp_source_ids_prop
              {special/normalizer}
              {\tl_set:Nx #2
                 {sot-\int_use:N \g__sot_comp_source_serial_int-normalizer-normalizer}}
              {\__sot_selector_error:n {#1}
               \tl_set:Nx #2
                 {sot-\int_use:N \g__sot_comp_source_serial_int-grid-grid}}
          }
      }
      {
        \seq_set_split:NVV \l__sot_selector_seq
          \c__sot_selector_colon_tl \l__sot_selector_value_tl
        \int_compare:nNnTF {\seq_count:N \l__sot_selector_seq} = {2}
          {
            \seq_pop_left:NN \l__sot_selector_seq \l__sot_selector_type_tl
            \seq_pop_left:NN \l__sot_selector_seq \l__sot_selector_value_tl
            \tl_trim_spaces:N \l__sot_selector_type_tl
            \tl_trim_spaces:N \l__sot_selector_value_tl
            \str_if_eq:VnTF \l__sot_selector_type_tl {cell}
              {
                \seq_set_split:NnV \l__sot_selector_aux_seq {/}
                  \l__sot_selector_value_tl
                \int_compare:nNnTF
                  {\seq_count:N \l__sot_selector_aux_seq} = {2}
                  {
                    \seq_pop_left:NN \l__sot_selector_aux_seq \l_tmpa_tl
                    \seq_pop_left:NN \l__sot_selector_aux_seq \l_tmpb_tl
                    \__sot_sanitize_id:VN \l_tmpa_tl \l__sot_selector_safe_tl
                    \__sot_sanitize_id:VN \l_tmpb_tl
                      \l__sot_selector_column_safe_tl
                    \tl_set:Nx \l_tmpa_tl
                      {cell/\l__sot_selector_safe_tl/
                       \l__sot_selector_column_safe_tl}
                    \prop_if_in:NVF \g__sot_comp_source_ids_prop \l_tmpa_tl
                      {
                        \bool_if:NTF \g__sot_comp_source_external_bool
                          {\__sot_selector_error:n {#1}}
                          {
                            \tl_set:Nx \l_tmpa_tl
                              {row/\l__sot_selector_safe_tl}
                            \prop_if_in:NVF \g__sot_comp_source_ids_prop
                              \l_tmpa_tl
                              {\__sot_selector_error:n {#1}}
                            \tl_set:Nx \l_tmpa_tl
                              {constraint/\l__sot_selector_column_safe_tl}
                            \prop_if_in:NVF \g__sot_comp_source_ids_prop
                              \l_tmpa_tl
                              {
                                \tl_set:Nx \l_tmpa_tl
                                  {metric/\l__sot_selector_column_safe_tl}
                                \prop_if_in:NVF
                                  \g__sot_comp_source_ids_prop \l_tmpa_tl
                                  {\__sot_selector_error:n {#1}}
                              }
                          }
                      }
                    \tl_set:Nx #2
                      {sot-\int_use:N \g__sot_comp_source_serial_int-cell-
                       \l__sot_selector_safe_tl-\l__sot_selector_column_safe_tl}
                    \bool_set_true:N \l__sot_resolved_anchor_inner_bool
                    \bool_set_true:N \l__sot_resolved_anchor_cell_bool
                  }
                  {\__sot_cell_selector_syntax_error:n {#1}
                   \tl_set:Nx #2
                     {sot-\int_use:N \g__sot_comp_source_serial_int-grid-grid}}
              }
              {
                \__sot_sanitize_id:VN
                  \l__sot_selector_value_tl \l__sot_selector_safe_tl
                \str_if_eq:VnT \l__sot_selector_type_tl {boundary}
                  {
                    %% Native tableaux derive a boundary from the exact right
                    %% edge of a registered constraint.  Opaque external
                    %% sources instead require an explicitly wrapped boundary;
                    %% silently treating it as a constraint would collapse two
                    %% distinct semantic coordinates into one node.
                    \bool_if:NF \g__sot_comp_source_external_bool
                      {\bool_set_true:N \l__sot_resolved_anchor_boundary_bool
                       \tl_set:Nn \l__sot_selector_type_tl {constraint}}
                  }
                \str_if_eq:VnF \l__sot_selector_type_tl {constraint}
                  {
                    \str_if_eq:VnF \l__sot_selector_type_tl {boundary}
                      {
                        \str_if_eq:VnF \l__sot_selector_type_tl {metric}
                          {
                            \str_if_eq:VnF \l__sot_selector_type_tl {row}
                              {
                                \str_if_eq:VnF \l__sot_selector_type_tl {fibre}
                                  {\__sot_selector_error:n {#1}
                                   \tl_set:Nn \l__sot_selector_type_tl {grid}}
                              }
                          }
                      }
                  }
                \str_if_eq:VnTF \l__sot_selector_type_tl {grid}
                  {\tl_set:Nx #2
                     {sot-\int_use:N \g__sot_comp_source_serial_int-grid-grid}}
                  {
                    \tl_set:Nx \l_tmpa_tl
                      {\l__sot_selector_type_tl/\l__sot_selector_safe_tl}
                    \prop_if_in:NVF \g__sot_comp_source_ids_prop \l_tmpa_tl
                      {\__sot_selector_error:n {#1}}
                    \tl_set:Nx #2
                      {sot-\int_use:N \g__sot_comp_source_serial_int-
                       \l__sot_selector_type_tl-\l__sot_selector_safe_tl}
                    \bool_set_true:N \l__sot_resolved_anchor_inner_bool
                  }
              }
          }
          {\__sot_selector_error:n {#1}
           \tl_set:Nx #2
             {sot-\int_use:N \g__sot_comp_source_serial_int-grid-grid}}
      }
  }
\cs_generate_variant:Nn \__sot_resolve_source_anchor:nN { VN }

%% A query can precede its source in the environment body.  Resolve every
%% declared selector only after source capture is complete, but before any
%% query record, lane, identifier, or global semantic flag is committed.
\cs_new_protected:Npn \__sot_preflight_query_source_anchors:
  {
    \bool_if:NT \l__sot_composing_bool
      {
        \bool_set_true:N \l__sot_query_preflight_bool
        \clist_set:NV \l_tmpa_clist \l__sot_query_anchors_tl
        \clist_map_inline:Nn \l_tmpa_clist
          {\__sot_resolve_source_anchor:nN {##1} \l_tmpa_tl}
        \tl_if_blank:VF \l__sot_query_witness_anchor_tl
          {\__sot_resolve_source_anchor:VN
             \l__sot_query_witness_anchor_tl \l_tmpa_tl}
        \tl_if_blank:VF \l__sot_query_mismatch_anchors_tl
          {
            \clist_set:NV \l_tmpa_clist
              \l__sot_query_mismatch_anchors_tl
            \clist_map_inline:Nn \l_tmpa_clist
              {\__sot_resolve_source_anchor:nN {##1} \l_tmpa_tl}
          }
        \bool_set_false:N \l__sot_query_preflight_bool
      }
  }

%% XeTeX records nodes nested inside a captured table box in the box's old
%% horizontal coordinate system.  The outer grid node is recorded after the
%% table is placed and is stable in all three engines.  Recover the local x
%% origin from that grid plus the known input-cell inset; y coordinates remain
%% native so tall rows and multiline headers keep their exact geometry.
\cs_new_protected:Npn \__sot_compute_anchor_x_correction:N #1
  {
    \pgfextractx{\l_tmpa_dim}
      {\pgfpointanchor
        {sot-\int_use:N \g__sot_comp_source_serial_int-grid-grid}{west}}
    \bool_if:NTF \g__sot_comp_source_external_bool
      {
        \pgfextractx{\l_tmpb_dim}
          {\pgfpointanchor
            {sot-\int_use:N
              \g__sot_comp_source_serial_int-external-origin}{center}}
        \dim_set:Nn #1 {\l_tmpa_dim-\l_tmpb_dim}
      }
      {
        \pgfextractx{\l_tmpb_dim}
          {\pgfpointanchor
            {sot-\int_use:N
              \g__sot_comp_source_serial_int-input-input}{west}}
        \dim_set:Nn #1
          {\l_tmpa_dim + \g__sot_comp_source_inner_offset_dim - \l_tmpb_dim}
      }
  }

