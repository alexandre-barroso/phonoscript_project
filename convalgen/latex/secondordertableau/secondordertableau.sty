    %% paragraph material with explicit breaks at its typed boundaries.
    \rlap{\__sot_comp_mark:nnn {map}{#7}{\strut}}
    \textbf{#1}:\allowbreak\ #2\allowbreak\
      \ensuremath{\mapsto}\allowbreak\ #3
    \par\noindent\scriptsize #4
