%% Query validation is transactional.  A semantic contradiction may issue a
%% normal LaTeX package error, but nonstop mode must never turn that rejected
%% record into a query label, verdict, scope rail, claim, padding lane, or
%% annotation.  Record only the first contradiction for one query; further
%% checks remain silent so diagnostics are deterministic.
\cs_new_protected:Npn \__sot_query_error:nn #1#2
  {
    \bool_if:NT \l__sot_query_valid_bool
      {
        \bool_set_false:N \l__sot_query_valid_bool
        \bool_set_true:N \l__sot_comp_had_invalid_query_bool
        \PackageError{secondordertableau}{#1}{#2}
      }
  }

