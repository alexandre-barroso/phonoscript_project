\newcommand\qot@setlanguage{%
  \qot@portuguesefalse
  \qot@statusvalidfalse
  \ifdefstring{\qot@language}{en}{\qot@statusvalidtrue}{}%
  \ifdefstring{\qot@language}{pt-BR}{\qot@portuguesetrue}{}%
  \ifdefstring{\qot@language}{pt-BR}{\qot@statusvalidtrue}{}%
  \ifqot@statusvalid\else
    \PackageError{secondordertableau}{Unsupported language `\qot@language'}%
      {Use the canonical language value en or pt-BR.}%
  \fi
}

