%% Draw one restrained independent-ranking separator over the complete placed
%% grid.  OTtablx established the useful jagged-boundary convention; the native
%% renderer keeps that semantics but uses a materially narrower, grid-contained
%% stroke.  The white under-stroke only opens enough of each horizontal rule to
%% keep the independent boundary continuous.  It must not create the broad
%% sawtooth cut-outs or top/bottom protrusions of the retired prototype.
%% Because the overlay is emitted only after final placement, captured source
%% tableaux retain byte-for-byte first-order geometry in all three engines.
\cs_new_protected:Npn \__sot_draw_independent_boundaries:nnnN #1#2#3#4
  {
    \seq_map_inline:Nn #4
      {
        \begin{tikzpicture}[remember~picture,overlay]
          \pgfextractx{\l_tmpa_dim}
            {\pgfpointanchor{sot-#1-grid-grid}{west}}
          \pgfextractx{\l_tmpb_dim}
            {\pgfpointanchor{sot-#1-input-input}{west}}
          \dim_set:Nn \l__sot_anchor_x_correction_dim
            {\l_tmpa_dim + #2 - \l_tmpb_dim + #3}
          \coordinate (sot-independent-#1-##1-top) at
            ([xshift=\l__sot_anchor_x_correction_dim]
              sot-#1-constraint-##1.north~east
              |- sot-#1-grid-grid.north);
          \coordinate (sot-independent-#1-##1-bottom) at
            ([xshift=\l__sot_anchor_x_correction_dim]
              sot-#1-constraint-##1.south~east
              |- sot-#1-grid-grid.south);
          \draw[white,line~width=1.55pt,line~cap=round,decorate,
            decoration={zigzag,segment~length=3.2pt,amplitude=.65pt}]
            (sot-independent-#1-##1-top)
            --(sot-independent-#1-##1-bottom);
          \draw[line~width=\l__sot_rule_dim,line~cap=round,decorate,
            decoration={zigzag,segment~length=3.2pt,amplitude=.65pt}]
            (sot-independent-#1-##1-top)
            --(sot-independent-#1-##1-bottom);
        \end{tikzpicture}
      }
  }

