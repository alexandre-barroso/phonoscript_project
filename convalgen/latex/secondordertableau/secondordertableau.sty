    \int_gincr:N \g__sot_table_serial_int
    \int_set_eq:NN \l__sot_source_serial_int \g__sot_table_serial_int
    \tl_if_blank:VT \l__sot_source_id_tl
      {\tl_set:Nx \l__sot_source_id_tl
         {external-\int_use:N \l__sot_source_serial_int}}
    \__sot_sanitize_id:VN \l__sot_source_id_tl \l__sot_source_id_safe_tl
    \prop_if_in:NVTF \g__sot_table_id_prop \l__sot_source_id_safe_tl
      {\PackageError{secondordertableau}
         {Duplicate~tableau~identifier~`\l__sot_source_id_tl'}
         {Give~each~explicitly~named~source~or~target~a~document-unique~id.}}
      {\prop_gput:NVx \g__sot_table_id_prop \l__sot_source_id_safe_tl
         {\int_use:N \l__sot_source_serial_int}}
    \prop_gclear:N \g__sot_external_ids_prop
    \bool_gset_true:N \g__sot_external_capture_bool
    \hbox_set:Nn \l__sot_source_content_box
      {\tikz[remember~picture,overlay,baseline]
         \coordinate
           (sot-\int_use:N \l__sot_source_serial_int-external-origin)
           at (0,0);
       #2}
    \bool_gset_false:N \g__sot_external_capture_bool
    \hbox_set:Nn \l__sot_source_marked_box
      {\tikzmarknode
         {sot-\int_use:N \l__sot_source_serial_int-grid-grid}
         {\box_use:N \l__sot_source_content_box}}
    \int_gincr:N \g__sot_comp_table_int
    \int_case:nnF {\g__sot_comp_table_int}
      {
        {1}
          {
            \bool_gset_true:N \g__sot_comp_source_external_bool
            \box_gset_eq:NN \g__sot_comp_source_box \l__sot_source_marked_box
            \int_gset_eq:NN \g__sot_comp_source_serial_int
              \l__sot_source_serial_int
            \tl_gset_eq:NN \g__sot_comp_source_id_tl
              \l__sot_source_id_safe_tl
            \dim_gset_eq:NN \g__sot_comp_source_rule_dim
              \l__sot_source_rule_dim
            \dim_gzero:N \g__sot_comp_source_tabcolsep_dim
            \dim_gzero:N \g__sot_comp_source_inner_offset_dim
            \seq_gclear:N \g__sot_comp_source_independent_boundary_seq
            \prop_gset_eq:NN \g__sot_comp_source_ids_prop
              \g__sot_external_ids_prop
            \prop_gput:Nnn \g__sot_comp_source_ids_prop
              {special/grid}{true}
          }
        {2}
          {
            \box_gset_eq:NN \g__sot_comp_target_box \l__sot_source_marked_box
            \int_gset_eq:NN \g__sot_comp_target_serial_int
              \l__sot_source_serial_int
            \tl_gset_eq:NN \g__sot_comp_target_id_tl
              \l__sot_source_id_safe_tl
            \dim_gset_eq:NN \g__sot_comp_target_rule_dim
              \l__sot_source_rule_dim
            \dim_gzero:N \g__sot_comp_target_tabcolsep_dim
            \dim_gzero:N \g__sot_comp_target_inner_offset_dim
            \seq_gclear:N \g__sot_comp_target_independent_boundary_seq
            \prop_gset_eq:NN \g__sot_comp_target_ids_prop
              \g__sot_external_ids_prop
            \prop_gput:Nnn \g__sot_comp_target_ids_prop
              {special/grid}{true}
          }
      }
      {\PackageError{secondordertableau}
         {A~secondordertableau~can~compose~at~most~two~source~objects}
         {Use~one~source,~or~one~source~and~one~target.}}
  }

