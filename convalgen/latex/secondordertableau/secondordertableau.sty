\cs_new_protected:Npn \__sot_validate_and_commit_qstep:nn #1#2
  {
    \bool_if:NT \l__sot_qcalc_valid_bool
      {
        \__sot_qstep_reset:
        \keys_set:nn { sot/qstep } {#1}
        \tl_trim_spaces:N \l__sot_qstep_rule_tl
        \tl_if_blank:VT \l__sot_qstep_rule_tl
          {\__sot_qcalc_error:nn
             {A~Q-Calculus~step~requires~rule}
             {Choose~one~admitted~rule~identifier~and~supply~rule=....}}
        \tl_if_blank:nT {#2}
          {\__sot_qcalc_error:nn
             {A~Q-Calculus~step~requires~an~expression}
             {Put~the~derived~surface~expression~in~the~mandatory~argument.}}
        \bool_if:NT \l__sot_qcalc_valid_bool
          {
            \exp_args:NNV \clist_if_in:NnTF
              \c__sot_qcalc_admitted_rule_clist \l__sot_qstep_rule_tl
              { }
              {\__sot_qcalc_error:nn
                 {Unknown~Q-Calculus~rule~`\l__sot_qstep_rule_tl'}
                 {Use~FORM,~READ,~MOVE,~TEST,~CLOSE-EQ,~CLOSE-NEQ,~OPEN,
                  ~PUSH,~JOIN,~JOIN-EQ,~JOIN-HIT,~PASTE,~PASTE-EQ,~DOWN,
                  ~LIFT,~TRACE,~READOUT,~CARD,~BUILD,~REQUEST,~STATUS,~or~RETURN.}}
          }
        \bool_if:NT \l__sot_qcalc_valid_bool
          {
            \str_case:VnF \l__sot_qstep_rule_tl
              {
                {BUILD}
                  {
                    \tl_if_blank:VTF \l__sot_qstep_operator_tl
                      {\__sot_qcalc_error:nn
                         {Q-Calculus~rule~BUILD~requires~operator}
                         {Choose~one~registered~BUILD-family~operator.}}
                      {\exp_args:NNV \clist_if_in:NnF
                         \c__sot_qcalc_build_operator_clist
                         \l__sot_qstep_operator_tl
                         {\__sot_qcalc_error:nn
                            {Unknown~or~wrong-family~BUILD~operator~`\l__sot_qstep_operator_tl'}
                            {Use~a~registered~term/query~constructor~operator.}}}
                  }
                {REQUEST}
                  {
                    \tl_if_blank:VTF \l__sot_qstep_operator_tl
                      {\__sot_qcalc_error:nn
                         {Q-Calculus~rule~REQUEST~requires~operator}
                         {Choose~one~registered~structural-request~operator.}}
                      {\exp_args:NNV \clist_if_in:NnF
                         \c__sot_qcalc_request_operator_clist
                         \l__sot_qstep_operator_tl
                         {\__sot_qcalc_error:nn
                            {Unknown~or~wrong-family~REQUEST~operator~`\l__sot_qstep_operator_tl'}
                            {Use~a~registered~structural-request~operator.}}}
                  }
                {STATUS}
                  {
                    \tl_if_blank:VTF \l__sot_qstep_operator_tl
                      {\__sot_qcalc_error:nn
                         {Q-Calculus~rule~STATUS~requires~operator}
                         {Use~operator=QC-SCIENCE.}}
                      {\str_if_eq:VnF \l__sot_qstep_operator_tl {QC-SCIENCE}
                         {\__sot_qcalc_error:nn
                            {Unknown~or~wrong-family~STATUS~operator~`\l__sot_qstep_operator_tl'}
                            {The~only~registered~STATUS~operator~is~QC-SCIENCE.}}}
                  }
              }
              {\tl_if_blank:VF \l__sot_qstep_operator_tl
                 {\__sot_qcalc_error:nn
                    {Q-Calculus~rule~`\l__sot_qstep_rule_tl'~cannot~declare~operator}
                    {Operator~badges~belong~only~to~BUILD,~REQUEST,~or~STATUS.}}}
          }
        \bool_if:NT \l__sot_qcalc_valid_bool
          {
            \bool_if:NT \l__sot_qcalc_terminal_seen_bool
              {\__sot_qcalc_error:nn
                 {A~Q-Calculus~step~occurs~after~the~terminal~step}
                 {CLOSE-EQ,~CLOSE-NEQ,~OPEN,~and~RETURN~end~a~derivation;
                  ~move~or~remove~the~later~step.}}
          }
        %% Query-free courses have a deliberately smaller grammar.  This is
        %% checked in source order, not inferred from vertical adjacency:
        %% BUILD* REQUEST RETURN, or the external STATUS RETURN course.
        \bool_if:NT \l__sot_qcalc_valid_bool
          {
            \int_compare:nNnT {\l__sot_comp_query_int} = {0}
              {
                \int_compare:nNnTF
                  {\l__sot_qcalc_request_int + \l__sot_qcalc_status_int} > {0}
                  {\str_if_eq:VnF \l__sot_qstep_rule_tl {RETURN}
                     {\__sot_qcalc_error:nn
                        {Only~RETURN~may~follow~a~REQUEST~or~STATUS~root}
                        {Use~BUILD~steps~only~before~REQUEST;~STATUS~is~followed~directly~by~RETURN.}}}
                  {\str_case:VnF \l__sot_qstep_rule_tl
                     {
                       {BUILD}{}
                       {REQUEST}{}
                       {STATUS}
                         {\int_compare:nNnT {\l__sot_qcalc_build_int} > {0}
                            {\__sot_qcalc_error:nn
                               {STATUS~mode~cannot~contain~BUILD}
                               {An~external~science-status~record~has~the~exact~course~STATUS~then~RETURN.}}}
                       {RETURN}
                         {\__sot_qcalc_error:nn
                            {RETURN~requires~a~preceding~REQUEST~or~STATUS~root}
                            {Use~BUILD~only~as~a~premise~course~before~one~REQUEST.}}
                     }
                     {\__sot_qcalc_error:nn
                        {Query-free~Q-Calculus~admits~only~BUILD,~REQUEST,~STATUS,~and~RETURN}
                        {Use~BUILD*~REQUEST~RETURN,~or~STATUS~RETURN;~move~query~rules~to~a~course~with~one~qQuery/qUse.}}}
              }
          }
        \bool_if:NT \l__sot_qcalc_valid_bool
          {
            \exp_args:NNV \clist_if_in:NnT
              \c__sot_qcalc_certificate_rule_clist \l__sot_qstep_rule_tl
              {\tl_if_blank:VT \l__sot_qstep_certificate_tl
                 {\__sot_qcalc_error:nn
                    {Q-Calculus~rule~`\l__sot_qstep_rule_tl'~requires~a~certificate}
                    {Supply~certificate=...~naming~the~checked~side-condition~record.}}}
          }
        \bool_if:NT \l__sot_qcalc_valid_bool
          {
            \str_if_eq:VnT \l__sot_qstep_rule_tl {CARD}
              {\tl_if_blank:VT \l__sot_qstep_card_id_tl
                 {\__sot_qcalc_error:nn
                    {Q-Calculus~rule~CARD~requires~card-id}
                    {Supply~card-id=...~naming~the~registered~theorem-card~instance.}}
               \tl_if_blank:VT \l__sot_qstep_authority_tl
                 {\__sot_qcalc_error:nn
                    {Q-Calculus~rule~CARD~requires~authority}
                    {Supply~authority=...~with~the~registered~provenance.}}
               \tl_if_blank:VT \l__sot_qstep_digest_tl
                 {\__sot_qcalc_error:nn
                    {Q-Calculus~rule~CARD~requires~digest}
                    {Supply~digest=...~with~the~immutable~record~locator.}}}
            \str_if_eq:VnT \l__sot_qstep_rule_tl {STATUS}
              {\tl_if_blank:VT \l__sot_qstep_authority_tl
                 {\__sot_qcalc_error:nn
                    {Q-Calculus~rule~STATUS~requires~authority}
                    {Supply~authority=...~with~the~registered~science-status~provenance.}}
               \tl_if_blank:VT \l__sot_qstep_digest_tl
                 {\__sot_qcalc_error:nn
                    {Q-Calculus~rule~STATUS~requires~digest}
                    {Supply~digest=...~with~the~immutable~science-status~record~locator.}}}
            \str_if_eq:VnF \l__sot_qstep_rule_tl {CARD}
              {\tl_if_blank:VF \l__sot_qstep_card_id_tl
                 {\__sot_qcalc_error:nn
                    {Q-Calculus~rule~`\l__sot_qstep_rule_tl'~cannot~declare~card-id}
                    {The~card-id~field~belongs~only~to~the~CARD~dispatcher.}}}
          }
        \bool_if:NT \l__sot_qcalc_valid_bool
          {
            \str_case:Vn \l__sot_qstep_rule_tl
              {
                {CLOSE-EQ}
                  {\bool_set_true:N \l__sot_qcalc_terminal_seen_bool
                   \int_incr:N \l__sot_qcalc_terminal_int
                   \tl_set_eq:NN \l__sot_qcalc_terminal_rule_tl
                     \l__sot_qstep_rule_tl}
                {CLOSE-NEQ}
                  {\bool_set_true:N \l__sot_qcalc_terminal_seen_bool
                   \int_incr:N \l__sot_qcalc_terminal_int
                   \tl_set_eq:NN \l__sot_qcalc_terminal_rule_tl
                     \l__sot_qstep_rule_tl}
                {OPEN}
                  {\bool_set_true:N \l__sot_qcalc_terminal_seen_bool
                   \int_incr:N \l__sot_qcalc_terminal_int
                   \tl_set_eq:NN \l__sot_qcalc_terminal_rule_tl
                     \l__sot_qstep_rule_tl}
                {RETURN}
                  {\bool_set_true:N \l__sot_qcalc_terminal_seen_bool
                   \int_incr:N \l__sot_qcalc_terminal_int
                   \tl_set_eq:NN \l__sot_qcalc_terminal_rule_tl
                     \l__sot_qstep_rule_tl}
                {BUILD}{\int_incr:N \l__sot_qcalc_build_int}
                {REQUEST}{\int_incr:N \l__sot_qcalc_request_int}
                {STATUS}{\int_incr:N \l__sot_qcalc_status_int}
              }
            \int_incr:N \l__sot_qcalc_step_int
            \seq_put_right:Nx \l__sot_qcalc_step_seq
              {
                \exp_not:N \__sot_qcalc_step_record:nnnnn
                  {\int_use:N \l__sot_qcalc_step_int}
                  {\exp_not:V \l__sot_qstep_rule_tl}
                  {\exp_not:V \l__sot_qstep_operator_tl}
                  {\exp_not:n {#2}}
                  {\exp_not:N \__sot_qcalc_step_meta_record:nnnnnn
                     {\exp_not:V \l__sot_qstep_premises_tl}
                     {\exp_not:V \l__sot_qstep_certificate_tl}
                     {\exp_not:V \l__sot_qstep_card_id_tl}
                     {\exp_not:V \l__sot_qstep_authority_tl}
                     {\exp_not:V \l__sot_qstep_digest_tl}
                     {\exp_not:V \l__sot_qstep_note_tl}}
              }
          }
      }
  }

\cs_new_protected:Npn \__sot_process_pending_qsteps:
  {
    \seq_map_inline:Nn \l__sot_qcalc_pending_step_seq {##1}
    \seq_clear:N \l__sot_qcalc_pending_step_seq
  }

\cs_new_protected:Npn \__sot_validate_qcalc_container:
  {
    \tl_if_blank:VT \l__sot_comp_alt_text_tl
      {\__sot_qcalc_error:nn
         {A~Q-Calculus~derivation~requires~alt-text}
         {Describe~the~ordered~steps~and~their~typed~result.}}
    \int_compare:nNnT {\l__sot_comp_query_int} = {1}
      {
        \tl_if_blank:VT \l__sot_comp_source_name_tl
          {\__sot_qcalc_error:nn
             {A~query-mode~Q-Calculus~requires~source}
             {Name~the~source~analysis~or~record.}}
        \tl_if_blank:VT \l__sot_comp_target_name_tl
          {\__sot_qcalc_error:nn
             {A~query-mode~Q-Calculus~requires~target}
             {Name~the~target~analysis~or~record.}}
        \tl_if_blank:VT \l__sot_comp_transformation_tl
          {\__sot_qcalc_error:nn
             {A~query-mode~Q-Calculus~requires~transformation}
             {Name~the~registered~transformation~between~source~and~target.}}
      }
  }

\cs_new_protected:Npn \__sot_finalize_qcalculus:
  {
    \bool_if:NT \l__sot_comp_had_invalid_query_bool
      {\bool_set_false:N \l__sot_qcalc_valid_bool}
    \__sot_process_pending_qsteps:
    \bool_if:NT \l__sot_qcalc_valid_bool
      {
        \int_compare:nNnF {\l__sot_qcalc_terminal_int} = {1}
          {\__sot_qcalc_error:nn
             {A~Q-Calculus~derivation~requires~exactly~one~terminal~step}
             {End~query~mode~with~CLOSE-EQ,~CLOSE-NEQ,~or~OPEN;
              ~end~structural/status~mode~with~RETURN.}}
      }
    \bool_if:NT \l__sot_qcalc_valid_bool
      {
        \int_compare:nNnTF {\l__sot_comp_query_int} = {1}
          {
            \int_compare:nNnF
              {\l__sot_qcalc_request_int + \l__sot_qcalc_status_int} = {0}
              {\__sot_qcalc_error:nn
                 {Query~mode~cannot~contain~REQUEST~or~STATUS}
                 {Move~the~independent~structural/status~derivation~to~its~own~qcalculus.}}
            \str_case:VnF \l__sot_qcalc_terminal_rule_tl
              {
                {CLOSE-EQ}
                  {\str_if_eq:VnF \l__sot_qcalc_result_tl {conservative}
                     {\__sot_qcalc_error:nn
                        {CLOSE-EQ~does~not~match~the~committed~query~result}
                        {Use~CLOSE-EQ~only~for~result=conservative.}}}
                {CLOSE-NEQ}
                  {\str_if_eq:VnF \l__sot_qcalc_result_tl {nonconservative}
                     {\__sot_qcalc_error:nn
                        {CLOSE-NEQ~does~not~match~the~committed~query~result}
                        {Use~CLOSE-NEQ~only~for~result=nonconservative.}}}
                {OPEN}
                  {\str_if_eq:VnF \l__sot_qcalc_result_tl {not-evaluated}
                     {\__sot_qcalc_error:nn
                        {OPEN~does~not~match~the~committed~query~result}
                        {Use~OPEN~only~for~result=not-evaluated.}}}
              }
              {\__sot_qcalc_error:nn
                 {Query~mode~requires~a~preservation~terminal}
                 {Use~CLOSE-EQ,~CLOSE-NEQ,~or~OPEN,~not~RETURN.}}
          }
          {
            \int_compare:nNnF {\l__sot_comp_query_int} = {0}
              {\__sot_qcalc_error:nn
                 {A~Q-Calculus~query~mode~requires~exactly~one~accepted~query}
                 {Use~one~qQuery/qUse,~or~none~for~structural/status~mode.}}
            \int_compare:nNnTF {\l__sot_qcalc_request_int} = {1}
              {\int_compare:nNnF {\l__sot_qcalc_status_int} = {0}
                 {\__sot_qcalc_error:nn
                    {Structural~mode~cannot~mix~REQUEST~and~STATUS}
                    {Use~one~typed~root~per~qcalculus.}}}
              {\int_compare:nNnTF {\l__sot_qcalc_status_int} = {1}
                 {\int_compare:nNnF {\l__sot_qcalc_request_int} = {0}
                    {\__sot_qcalc_error:nn
                       {Status~mode~cannot~mix~STATUS~and~REQUEST}
                       {Use~one~typed~root~per~qcalculus.}}}
                 {\__sot_qcalc_error:nn
                    {A~query-free~Q-Calculus~requires~exactly~one~REQUEST~or~STATUS~root}
                    {Choose~one~structural~request~or~one~science-status~record.}}}
            \str_if_eq:VnF \l__sot_qcalc_terminal_rule_tl {RETURN}
              {\__sot_qcalc_error:nn
                 {Structural~and~status~modes~require~RETURN}
                 {Preservation~terminals~belong~only~to~query~mode.}}
          }
      }
    \bool_if:NT \l__sot_qcalc_valid_bool
      {\__sot_validate_qcalc_container:}
  }

\cs_new_protected:Npn \__sot_validate_and_commit_query:n #1
  {
    \__sot_query_reset:
    \keys_set:nn { sot/query } {#1}
    \__sot_resolve_query_profile:
    \__sot_resolve_query_family_cap:
    \bool_if:NT \l__sot_qcalculating_bool
      {\bool_if:NF \l__sot_query_registered_answer_bool
         {\__sot_query_error:nn
            {Q-Calculus~requires~a~registered~query~answer~sort}
            {Use~a~registered~profile/answer~whose~cap~is~synthesized~by~the~package;~route~a~custom~certified~construction~through~CARD~or~BUILD~without~forging~a~Q-verdict.}}}
    \__sot_resolve_query_display:
    \tl_if_blank:VT \l__sot_query_id_tl
      {\tl_set:Nx \l__sot_query_id_tl
         { Q\int_use:N \l__sot_query_serial_int }}
    \tl_if_blank:VT \l__sot_query_label_tl
      {\tl_set:Nx \l__sot_query_label_tl
         { Q\int_use:N \l__sot_query_serial_int }}
    \__sot_query_require_tl:Nn \l__sot_query_answer_tl {query~answer}
    \__sot_query_require_tl:Nn \l__sot_query_scope_tl {query~scope}
    \__sot_query_require_tl:Nn \l__sot_query_result_tl {query~result}
    \tl_set:Nx \l_tmpa_tl {\l__sot_query_id_tl}
    \tl_trim_spaces:N \l_tmpa_tl
    \tl_set:Nx \l_tmpb_tl {query/\l_tmpa_tl}
    \prop_if_in:NVTF \l__sot_comp_id_prop \l_tmpb_tl
      {\__sot_query_error:nn
         {Duplicate~query~identifier~`\l__sot_query_id_tl'}
         {Every~accepted~query~inside~one~composition~needs~a~unique~id.}}
      { }
    \str_if_eq:VnT \l__sot_query_exactness_tl {rounded}
      {
        \__sot_query_require_tl:Nn \l__sot_query_tolerance_tl
          {tolerance~or~rounding~rule~for~an~approximate~comparison}
        \str_if_eq:VnF \l__sot_query_result_tl {not-evaluated}
          {\__sot_query_error:nn
             {Rounded~values~cannot~license~an~exact~Q-verdict}
             {Use~result=not-evaluated~and~name~the~missing~exactness~dependency,~or~declare~a~custom~exact~query~over~registered~rounding~classes~or~a~separate~Boolean~threshold~decision.}}
      }
    \str_if_eq:VnT \l__sot_query_exactness_tl {exact}
      {
        \tl_if_blank:VF \l__sot_query_tolerance_tl
          {\__sot_query_error:nn
             {An~exact~comparison~cannot~declare~a~rounding~tolerance}
             {Remove~tolerance=...,~or~set~exactness=rounded~and~state~the~approximation~rule.}}
      }
    \str_if_eq:VnF \l__sot_query_result_tl {not-evaluated}
      {
        \str_if_eq:VnT \l__sot_query_answer_tl {TRACE}
          {\str_if_eq:VnF \l__sot_query_stopping_tl {declared}
            {\__sot_query_error:nn
               {A~TRACE~query~has~no~declared~stopping~semantics}
               {Set~stopping=declared~and~name~the~stopping~dependency,~or~use~result=not-evaluated~with~stopping=missing~and~a~precise~blocked-by~record.}}}
        \str_if_eq:VnT \l__sot_query_answer_tl {TERMINAL}
          {\str_if_eq:VnF \l__sot_query_stopping_tl {declared}
            {\__sot_query_error:nn
               {A~TERMINAL~query~has~no~declared~stopping~semantics}
               {Set~stopping=declared~and~name~the~stopping~dependency,~or~use~result=not-evaluated~with~stopping=missing~and~a~precise~blocked-by~record.}}}
      }
    %% The answer sort already supplies the public codomain shorthand.  Serial
    %% answers additionally need their dependent mode index; nonserial
    %% registered sorts reject that index rather than silently ignoring it.
    \str_case:Vn \l__sot_query_answer_tl
      {
        {TRACE}
          {\str_if_eq:VnF \l__sot_query_result_tl {not-evaluated}
             {\str_if_eq:VnT \l__sot_query_serial_mode_tl {not-applicable}
                {\__sot_query_error:nn
                   {An~evaluated~TRACE~query~requires~a~serial-mode}
                   {Set~serial-mode=set,~probability,~or~series~to~name~the~registered~dependent~answer~type.}}}}
        {TERMINAL}
          {\str_if_eq:VnF \l__sot_query_result_tl {not-evaluated}
             {\str_if_eq:VnT \l__sot_query_serial_mode_tl {not-applicable}
                {\__sot_query_error:nn
                   {An~evaluated~TERMINAL~query~requires~a~serial-mode}
                   {Set~serial-mode=set,~probability,~or~series~to~name~the~registered~dependent~answer~type.}}}}
        {WIN}{\str_if_eq:VnF \l__sot_query_serial_mode_tl {not-applicable}
          {\__sot_query_error:nn {A~nonserial~WIN~query~cannot~declare~serial-mode}
             {Use~serial-mode=not-applicable.}}}
        {ORDER}{\str_if_eq:VnF \l__sot_query_serial_mode_tl {not-applicable}
          {\__sot_query_error:nn {A~nonserial~ORDER~query~cannot~declare~serial-mode}
             {Use~serial-mode=not-applicable.}}}
        {MARGIN}{\str_if_eq:VnF \l__sot_query_serial_mode_tl {not-applicable}
          {\__sot_query_error:nn {A~nonserial~MARGIN~query~cannot~declare~serial-mode}
             {Use~serial-mode=not-applicable.}}}
        {PROBABILITY}{\str_if_eq:VnF \l__sot_query_serial_mode_tl {not-applicable}
          {\__sot_query_error:nn {A~nonserial~PROBABILITY~query~cannot~declare~serial-mode}
             {Use~serial-mode=not-applicable.}}}
        {SUPPORT}{\str_if_eq:VnF \l__sot_query_serial_mode_tl {not-applicable}
          {\__sot_query_error:nn {A~nonserial~SUPPORT~query~cannot~declare~serial-mode}
             {Use~serial-mode=not-applicable.}}}
        {REALIZATION}{\str_if_eq:VnF \l__sot_query_serial_mode_tl {not-applicable}
          {\__sot_query_error:nn {A~nonserial~REALIZATION~query~cannot~declare~serial-mode}
             {Use~serial-mode=not-applicable.}}}
        {EVIDENCE}{\str_if_eq:VnF \l__sot_query_serial_mode_tl {not-applicable}
          {\__sot_query_error:nn {A~nonserial~EVIDENCE~query~cannot~declare~serial-mode}
             {Use~serial-mode=not-applicable.}}}
      }
    \clist_set:NV \l_tmpa_clist \l__sot_query_anchors_tl
    \int_set:Nn \l_tmpa_int {\clist_count:N \l_tmpa_clist}
    \clist_remove_duplicates:N \l_tmpa_clist
    \int_compare:nNnF {\clist_count:N \l_tmpa_clist} = {\l_tmpa_int}
      {\__sot_query_error:nn
         {A~query~incidence~list~contains~duplicate~anchors}
         {Name~each~semantic~row,~column,~cell,~fibre,~or~special~anchor~once.}}
    \str_if_eq:VnT \l__sot_query_answer_tl {PROBABILITY}
      {\str_if_eq:VnF \l__sot_query_incidence_tl {global}
         {\__sot_query_error:nn
            {A~PROBABILITY~query~requires~global~incidence}
            {Use~incidence=global~and~name~the~support~and~normalization~dependencies.}}}
    \str_if_eq:VnT \l__sot_query_answer_tl {TRACE}
      {\str_if_eq:VnF \l__sot_query_incidence_tl {trace}
         {\__sot_query_error:nn
            {A~TRACE~query~requires~trace~incidence}
            {Use~incidence=trace~and~anchor~every~registered~stage.}}}
    \str_if_eq:VnT \l__sot_query_answer_tl {TERMINAL}
      {\str_if_eq:VnF \l__sot_query_incidence_tl {terminal}
         {\__sot_query_error:nn
            {A~TERMINAL~query~requires~terminal~incidence}
            {Use~incidence=terminal~and~anchor~the~final~readout.}}}
    \str_if_eq:VnTF \l__sot_query_result_tl {not-evaluated}
      {
        \__sot_query_require_tl:Nn \l__sot_query_blocked_tl {blocked-by}
        \tl_if_blank:VT \l__sot_query_admission_tl
          {\tl_set:Nn \l__sot_query_admission_tl {not-admitted}}
        \str_if_eq:VnT \l__sot_query_admission_tl {admitted}
          {\__sot_query_error:nn
             {A~not-evaluated~query~cannot~declare~admission=admitted}
             {Use~admission=not-admitted~and~name~the~failed~dependency;~an~admitted~formed~query~must~receive~an~evaluated~verdict.}}
        \tl_if_blank:VT \l__sot_query_transport_tl
          {
            \str_if_eq:VnTF \l__sot_comp_language_tl {pt-BR}
              {\tl_set:Nn \l__sot_query_transport_tl {indefinido}}
              {\tl_set:Nn \l__sot_query_transport_tl {undefined}}
          }
        \tl_if_blank:VF \l__sot_query_witness_tl
          {\__sot_query_error:nn
             {A~not-evaluated~query~cannot~declare~a~witness}
             {Use~blocked-by~for~the~failed~dependency~and~omit~witness.}}
        \tl_if_blank:VF \l__sot_query_selector_certificate_tl
          {\__sot_query_error:nn
             {A~not-evaluated~query~cannot~declare~a~selector-certificate}
             {No~mismatch~focus~exists~before~the~answer~comparison~is~formed.}}
        \tl_if_blank:VF \l__sot_query_witness_anchor_tl
          {\__sot_query_error:nn
             {A~not-evaluated~query~cannot~declare~a~witness-anchor}
             {The~comparison~stopped~before~a~mismatch~was~formed;~name~the~failed~dependency~instead.}}
        \tl_if_blank:VF \l__sot_query_mismatch_tl
          {\__sot_query_error:nn
             {A~not-evaluated~query~cannot~declare~a~mismatch-set}
             {The~comparison~stopped~before~a~mismatch~set~was~formed;~name~the~failed~dependency~instead.}}
        \tl_if_blank:VF \l__sot_query_mismatch_anchors_tl
          {\__sot_query_error:nn
             {A~not-evaluated~query~cannot~declare~mismatch-anchors}
             {The~comparison~stopped~before~mismatches~were~located;~name~the~failed~dependency~instead.}}
        \tl_if_blank:VF \l__sot_query_equivalence_tl
          {\__sot_query_error:nn
             {A~not-evaluated~query~cannot~declare~an~equivalence~basis}
             {The~comparison~was~not~admitted,~so~no~equality~claim~may~be~registered.}}
        \tl_if_blank:VT \l__sot_query_source_tl
          {\tl_set:Nn \l__sot_query_source_tl {---}}
        \tl_if_blank:VT \l__sot_query_transported_tl
          {\tl_set:Nn \l__sot_query_transported_tl {---}}
        \tl_if_blank:VT \l__sot_query_target_tl
          {\tl_set:Nn \l__sot_query_target_tl {---}}
      }
      {
        \tl_if_blank:VT \l__sot_query_formation_tl
          {\tl_set:Nn \l__sot_query_formation_tl {formed}}
        \tl_if_blank:VT \l__sot_query_admission_tl
          {\tl_set:Nn \l__sot_query_admission_tl {admitted}}
        \str_if_eq:VnF \l__sot_query_formation_tl {formed}
          {\__sot_query_error:nn
             {An~evaluated~query~requires~formation=formed}
             {Use~result=not-evaluated~and~name~the~failed~formation~dependency.}}
        \str_if_eq:VnF \l__sot_query_admission_tl {admitted}
          {\__sot_query_error:nn
             {An~evaluated~query~requires~admission=admitted}
             {Use~result=not-evaluated~and~name~the~failed~admission~dependency.}}
        \tl_if_blank:VT \l__sot_query_transport_tl
          {\tl_set:Nn \l__sot_query_transport_tl {identity}}
        \__sot_query_require_tl:Nn \l__sot_query_source_tl {source~answer}
        \__sot_query_require_tl:Nn \l__sot_query_target_tl {target~answer}
        \str_if_eq:VnTF \l__sot_query_transport_tl {identity}
          {
            \tl_if_blank:VTF \l__sot_query_transported_tl
              {\tl_set_eq:NN \l__sot_query_transported_tl
                 \l__sot_query_source_tl}
              {\tl_if_eq:NNF \l__sot_query_source_tl
                   \l__sot_query_transported_tl
                 {\__sot_query_error:nn
                    {Identity~transport~cannot~change~the~source~answer}
                    {Make~source~and~transported~identical,~or~name~a~nonidentity~transport.}}}
          }
          {\__sot_query_require_tl:Nn \l__sot_query_transported_tl
             {transported-source~answer}}
        \tl_set_eq:NN \l_tmpa_tl \l__sot_query_transported_tl
        \tl_set_eq:NN \l_tmpb_tl \l__sot_query_target_tl
        \tl_trim_spaces:N \l_tmpa_tl
        \tl_trim_spaces:N \l_tmpb_tl
        \str_if_eq:VnTF \l__sot_query_result_tl {conservative}
          {
            \tl_if_blank:VF \l__sot_query_witness_tl
              {\__sot_query_error:nn
                 {A~conservative~query~cannot~declare~a~mismatch~witness}
                 {Remove~witness~or~use~result=nonconservative.}}
            \tl_if_blank:VF \l__sot_query_selector_certificate_tl
              {\__sot_query_error:nn
                 {A~conservative~query~cannot~declare~a~selector-certificate}
                 {A~selector~certificate~belongs~only~to~an~optional~nonconservative~focus.}}
            \tl_if_blank:VF \l__sot_query_witness_anchor_tl
              {\__sot_query_error:nn
                 {A~conservative~query~cannot~declare~a~witness-anchor}
                 {Remove~the~witness~geometry~or~use~result=nonconservative.}}
            \tl_if_blank:VF \l__sot_query_mismatch_tl
              {\__sot_query_error:nn
                 {A~conservative~query~cannot~declare~a~mismatch-set}
                 {Remove~the~mismatch~set~or~use~result=nonconservative.}}
            \tl_if_blank:VF \l__sot_query_mismatch_anchors_tl
              {\__sot_query_error:nn
                 {A~conservative~query~cannot~declare~mismatch-anchors}
                 {Remove~the~mismatch~geometry~or~use~result=nonconservative.}}
            \tl_if_eq:NNF \l_tmpa_tl \l_tmpb_tl
              {\__sot_query_require_tl:Nn \l__sot_query_equivalence_tl
                 {equivalence~basis~for~nonliteral~equal~answers}}
          }
          {
            \tl_if_eq:NNT \l_tmpa_tl \l_tmpb_tl
              {\__sot_query_error:nn
                 {A~nonconservative~query~has~identical~transported~and~target~answers}
                 {Correct~one~answer,~or~use~result=conservative;~the~package~will~not~print~inequality~between~identical~registered~values.}}
            \__sot_query_require_tl:Nn \l__sot_query_mismatch_tl
              {complete~mismatch-set}
            \tl_if_blank:VTF \l__sot_query_witness_tl
              {\tl_if_blank:VF \l__sot_query_selector_certificate_tl
                 {\__sot_query_error:nn
                    {A~selector-certificate~cannot~occur~without~a~selected~witness}
                    {Remove~selector-certificate,~or~name~the~licensed~optional~focus.}}}
              {\__sot_query_require_tl:Nn
                 \l__sot_query_selector_certificate_tl
                 {selector-certificate~for~the~optional~mismatch~focus}}
            \tl_if_blank:VF \l__sot_query_equivalence_tl
              {\__sot_query_error:nn
                 {A~nonconservative~query~cannot~declare~an~equivalence~basis}
                 {Remove~equivalence=...;~the~witness~and~complete~mismatch~set~license~the~inequality.}}
            \bool_if:nT
              {\l__sot_composing_bool
               && ! \tl_if_blank_p:V \l__sot_query_witness_tl}
              {
                \tl_if_blank:VT \l__sot_query_witness_anchor_tl
                  {
                    \tl_if_blank:VTF \l__sot_query_mismatch_anchors_tl
                      {
                        \clist_set:NV \l_tmpa_clist \l__sot_query_anchors_tl
                        \int_compare:nNnTF {\clist_count:N \l_tmpa_clist} = {1}
                          {\tl_set:Nx \l__sot_query_witness_anchor_tl
                             {\clist_item:Nn \l_tmpa_clist {1}}}
                          {\__sot_query_require_tl:Nn \l__sot_query_witness_anchor_tl
                             {witness-anchor~for~an~ambiguous~multi-anchor~query}}
                      }
                      {
                        \clist_set:NV \l_tmpa_clist
                          \l__sot_query_mismatch_anchors_tl
                        \int_compare:nNnTF
                          {\clist_count:N \l_tmpa_clist} = {1}
                          {\tl_set:Nx \l__sot_query_witness_anchor_tl
                             {\clist_item:Nn \l_tmpa_clist {1}}}
                          {\__sot_query_require_tl:Nn
                             \l__sot_query_witness_anchor_tl
                             {witness-anchor~for~an~ambiguous~multi-anchor~query}}
                      }
                  }
                \tl_if_blank:VT \l__sot_query_mismatch_anchors_tl
                  {\tl_set_eq:NN \l__sot_query_mismatch_anchors_tl
                     \l__sot_query_witness_anchor_tl}
                \clist_set:NV \l_tmpa_clist \l__sot_query_anchors_tl
                \clist_set:NV \l_tmpb_clist
                  \l__sot_query_mismatch_anchors_tl
                \int_set:Nn \l_tmpa_int {\clist_count:N \l_tmpb_clist}
                \clist_remove_duplicates:N \l_tmpb_clist
                \int_compare:nNnF {\clist_count:N \l_tmpb_clist}
                  = {\l_tmpa_int}
                  {\__sot_query_error:nn
                     {A~query~mismatch-anchors~list~contains~duplicates}
                     {Name~each~mismatching~coordinate~once.}}
                \clist_map_inline:Nn \l_tmpb_clist
                  {
                    \clist_if_in:NnF \l_tmpa_clist {##1}
                      {\__sot_query_error:nn
                         {Mismatch~anchor~`##1'~is~outside~the~query~incidence}
                         {Every~mismatch-anchor~must~also~occur~in~anchors=...~for~that~query.}}
                  }
                \exp_args:NNV \clist_if_in:NnF \l_tmpb_clist
                  \l__sot_query_witness_anchor_tl
                  {\__sot_query_error:nn
                     {The~selected~witness-anchor~is~not~in~the~complete~mismatch-anchors~set}
                     {Add~the~witness~coordinate~to~mismatch-anchors,~or~select~a~witness~from~that~set.}}
              }
          }
        \tl_if_blank:VF \l__sot_query_blocked_tl
          {\__sot_query_error:nn
             {An~evaluated~query~cannot~declare~blocked-by}
             {Use~requires~for~satisfied~dependencies.}}
      }
    \str_if_eq:VnT \l__sot_comp_disclosure_tl {audit}
      {
        \__sot_query_require_tl:Nn \l__sot_query_bearer_tl {query~bearer}
        \__sot_query_require_tl:Nn \l__sot_query_support_tl {query~support}
        \__sot_query_require_tl:Nn \l__sot_query_layer_tl {scientific~layer}
        \__sot_query_require_tl:Nn \l__sot_query_formation_tl {formation~status}
        \__sot_query_require_tl:Nn \l__sot_query_admission_tl {admission~status}
        \__sot_query_require_tl:Nn \l__sot_query_provenance_tl {query~provenance}
        \str_if_eq:VnT \l__sot_query_result_tl {nonconservative}
          {\__sot_query_require_tl:Nn \l__sot_query_mismatch_tl
             {complete~mismatch-set}}
      }
    \bool_if:NT \l__sot_query_valid_bool
      {\__sot_preflight_query_source_anchors:}
    \bool_if:NT \l__sot_query_valid_bool
      {
        %% Atomic commit.  No query-derived identifier, ordinal, lane, flag,
        %% record, or geometry exists before this boundary.
        \int_incr:N \l__sot_comp_query_int
        \__sot_comp_register_id:nn {query}{\l__sot_query_id_tl}
        %% The Q-Calculus terminal checker observes the result of this very
        %% commit.  It does not parse a rendered glyph or maintain an
        %% independent verdict record.
        \bool_if:NT \l__sot_qcalculating_bool
          {\tl_set_eq:NN \l__sot_qcalc_result_tl
             \l__sot_query_result_tl}
        \bool_if:NT \l__sot_composing_bool
          {\exp_args:NnV \__sot_reserve_incidence_extent:nn
             {\int_use:N \l__sot_comp_query_int}
             \l__sot_query_incidence_tl
           \str_if_eq:VnT \l__sot_query_result_tl {nonconservative}
             {\dim_set:Nn \l_tmpa_dim
                {16pt*\l__sot_comp_query_int+6pt}
              \dim_set:Nn \l__sot_comp_right_pad_dim
                {\dim_max:nn
                   {\l__sot_comp_right_pad_dim}{\l_tmpa_dim}}}}
        \str_if_eq:VnT \l__sot_query_answer_tl {PROBABILITY}
          {\bool_set_true:N \l__sot_comp_probability_bool
           \str_if_eq:VnF \l__sot_query_result_tl {not-evaluated}
             {\bool_set_true:N \l__sot_comp_probability_evaluated_bool}}
        \str_if_eq:VnT \l__sot_query_answer_tl {TRACE}
          {\str_if_eq:VnF \l__sot_query_result_tl {not-evaluated}
             {\bool_set_true:N \l__sot_comp_trace_bool}}
        \tl_if_blank:VF \l__sot_query_layer_tl
          {
            \tl_if_blank:VTF \l__sot_comp_first_layer_tl
              {\tl_set_eq:NN \l__sot_comp_first_layer_tl
                 \l__sot_query_layer_tl}
              {\tl_if_eq:NNF \l__sot_comp_first_layer_tl
                   \l__sot_query_layer_tl
                 {\bool_set_true:N \l__sot_comp_mixed_layers_bool}}
          }
        \str_if_eq:VnF \l__sot_query_result_tl {not-evaluated}
          {\bool_set_true:N \l__sot_comp_evaluated_query_bool
           \str_if_eq:VnF \l__sot_query_transport_tl {identity}
             {\bool_set_true:N \l__sot_comp_nonidentity_transport_bool}}
    \seq_put_right:Nx \l__sot_comp_query_seq
      {
        \exp_not:N \__sot_query_record:nnnnnnnnn
          {\exp_not:V \l__sot_query_label_tl}
          {\exp_not:N \__sot_query_sort_display:nn
             {\exp_not:V \l__sot_query_display_tl}
             {\exp_not:V \l__sot_query_serial_mode_tl}}
          {\exp_not:N \__sot_query_scope_display:nnnnnnnn
             {\exp_not:V \l__sot_query_scope_tl}
             {\exp_not:V \l__sot_query_result_tl}
             {\exp_not:N \__sot_query_value:nn
               {\exp_not:V \l__sot_query_witness_format_tl}
               {\exp_not:V \l__sot_query_witness_tl}}
             {\exp_not:N \__sot_query_value:nn
               {\exp_not:V \l__sot_query_dependency_format_tl}
               {\exp_not:V \l__sot_query_blocked_tl}}
             {\exp_not:V \l__sot_query_equivalence_tl}
             {\exp_not:V \l__sot_query_exactness_tl}
             {\exp_not:V \l__sot_query_tolerance_tl}
             {\exp_not:V \l__sot_query_selector_certificate_tl}}
          {\exp_not:V \l__sot_query_transport_tl}
          {\exp_not:V \l__sot_query_source_tl}
          {\exp_not:V \l__sot_query_transported_tl}
          {\exp_not:V \l__sot_query_target_tl}
          {\exp_not:V \l__sot_query_value_format_tl}
          {\exp_not:N \__sot_result_display:nn
             {\exp_not:V \l__sot_query_result_tl}
             {\exp_not:V \l__sot_query_exactness_tl}}
      }
    \seq_put_right:Nx \l__sot_comp_foot_seq
      {
        \exp_not:N \__sot_query_foot:nnnnnnnnn
          {\exp_not:V \l__sot_query_label_tl}
          {\exp_not:V \l__sot_query_incidence_tl}
          {\exp_not:V \l__sot_query_anchors_tl}
          {\exp_not:V \l__sot_query_requires_tl}
          {\exp_not:V \l__sot_query_scope_tl}
          {\exp_not:V \l__sot_query_ceiling_tl}
          {\exp_not:N \__sot_query_value:nn
             {\exp_not:V \l__sot_query_witness_format_tl}
             {\exp_not:V \l__sot_query_witness_tl}}
          {\exp_not:N \__sot_query_value:nn
             {\exp_not:V \l__sot_query_dependency_format_tl}
             {\exp_not:V \l__sot_query_blocked_tl}}
          {\exp_not:V \l__sot_query_result_tl}
      }
    \seq_put_right:Nx \l__sot_comp_audit_seq
      {
        \exp_not:N \__sot_query_audit:nnnnnnnn
          {\exp_not:V \l__sot_query_bearer_tl}
          {\exp_not:V \l__sot_query_support_tl}
          {\exp_not:V \l__sot_query_evaluator_tl}
          {\exp_not:V \l__sot_query_layer_tl}
          {\exp_not:V \l__sot_query_formation_tl}
          {\exp_not:V \l__sot_query_admission_tl}
          {\exp_not:N \__sot_query_value:nn
             {\exp_not:V \l__sot_query_mismatch_format_tl}
             {\exp_not:V \l__sot_query_mismatch_tl}}
          {\exp_not:N \__sot_query_audit_tail:nnnnnnnnn
             {\exp_not:V \l__sot_query_profile_tl}
             {\exp_not:V \l__sot_query_answer_tl}
             {\exp_not:V \l__sot_query_ceiling_tl}
             {\exp_not:V \l__sot_query_provenance_tl}
             {\exp_not:N \__sot_exactness_display:nn
                {\exp_not:V \l__sot_query_exactness_tl}
                {\exp_not:V \l__sot_query_tolerance_tl}}
             {\exp_not:V \l__sot_query_result_tl}
             {\exp_not:V \l__sot_query_equivalence_tl}
             {\exp_not:V \l__sot_query_witness_anchor_tl}
             {\exp_not:V \l__sot_query_mismatch_anchors_tl}
           \exp_not:N \__sot_query_audit_supplement:nnn
             {\exp_not:V \l__sot_query_selector_certificate_tl}
             {\exp_not:V \l__sot_query_serial_mode_tl}
             {\exp_not:V \l__sot_query_stopping_tl}}
      }
    \seq_put_right:Nx \l__sot_comp_judgment_seq
      {
        \exp_not:N \__sot_judgment_record:nnnnnnnn
          {\exp_not:V \l__sot_query_label_tl}
          {\exp_not:N \__sot_query_sort_display:nn
             {\exp_not:V \l__sot_query_display_tl}
             {\exp_not:V \l__sot_query_serial_mode_tl}}
          {\exp_not:V \l__sot_query_result_tl}
          {\exp_not:N \__sot_query_value:nn
             {\exp_not:V \l__sot_query_witness_format_tl}
             {\exp_not:V \l__sot_query_witness_tl}}
          {\exp_not:N \__sot_query_value:nn
             {\exp_not:V \l__sot_query_dependency_format_tl}
             {\exp_not:V \l__sot_query_blocked_tl}}
          {\exp_not:V \l__sot_query_exactness_tl}
          {\exp_not:V \l__sot_query_tolerance_tl}
          {\exp_not:V \l__sot_query_equivalence_tl}
      }
    \seq_put_right:Nx \l__sot_comp_claim_seq
      {
        \exp_not:N \__sot_claim_record:nnnnn
          {\exp_not:V \l__sot_query_display_tl}
          {\exp_not:V \l__sot_query_result_tl}
          {\exp_not:V \l__sot_query_ceiling_tl}
          {\exp_not:N \__sot_query_value:nn
             {\exp_not:V \l__sot_query_witness_format_tl}
             {\exp_not:V \l__sot_query_witness_tl}}
          {\exp_not:N \__sot_query_value:nn
             {\exp_not:V \l__sot_query_dependency_format_tl}
             {\exp_not:V \l__sot_query_blocked_tl}}
      }
    \bool_if:NT \l__sot_composing_bool
      {
        \seq_put_right:Nx \l__sot_comp_incidence_seq
          {\exp_not:N \__sot_draw_incidence:nnnnnn
            {\int_use:N \l__sot_comp_query_int}
            {\exp_not:V \l__sot_query_label_tl}
            {\exp_not:V \l__sot_query_incidence_tl}
            {\exp_not:V \l__sot_query_anchors_tl}
            {\exp_not:V \l__sot_query_result_tl}
            {\exp_not:N \__sot_query_value:nn
               {\exp_not:V \l__sot_query_dependency_format_tl}
               {\exp_not:V \l__sot_query_blocked_tl}}}
        \str_if_eq:VnT \l__sot_query_result_tl {nonconservative}
          {
            \seq_put_right:Nx \l__sot_comp_mismatch_seq
              {\exp_not:N \__sot_draw_mismatch_set:nnn
                {\int_use:N \l__sot_comp_query_int}
                {\exp_not:V \l__sot_query_witness_anchor_tl}
                {\exp_not:V \l__sot_query_mismatch_anchors_tl}}
          }
      }
      }
  }

\cs_new_protected:Npn \__sot_add_change:nnn #1#2#3
  {
    \bool_if:nF {\l__sot_composing_bool || \l__sot_judging_bool}
      {\PackageError{secondordertableau}
         {sotChange~must~occur~inside~secondordertableau~or~sotjudgment}
         {Attach~the~change~to~the~tableau~whose~geometry~it~modifies,~or~to~the~standalone~judgment~it~defines.}}
    \tl_clear:N \l__sot_change_id_tl
    \tl_set:Nn \l__sot_change_anchor_tl { grid }
    \tl_set:Nn \l__sot_change_label_tl
      { \ensuremath{\Delta T\sb{Q}} }
    \tl_clear:N \l__sot_change_profile_tl
    \tl_set:Nn \l__sot_change_value_format_tl {plain}
    \int_incr:N \l__sot_comp_change_int
    \keys_set:nn { sot/change } {#1}
    \tl_if_blank:VF \l__sot_change_profile_tl
      {
        \str_case:VnF \l__sot_change_profile_tl
          {
            {rerank}{}
            {reweight}{}
            {rescale}{}
            {change-reader}{}
            {add-candidate}
              {\bool_set_true:N \l__sot_comp_support_change_bool
               \bool_set_true:N \l__sot_comp_explicit_transport_required_bool}
            {delete-candidate}
              {\bool_set_true:N \l__sot_comp_support_change_bool
               \bool_set_true:N \l__sot_comp_explicit_transport_required_bool}
            {merge}
              {\bool_set_true:N \l__sot_comp_support_change_bool
               \bool_set_true:N \l__sot_comp_explicit_transport_required_bool
               \bool_set_true:N \l__sot_comp_merge_bool}
            {split}
              {\bool_set_true:N \l__sot_comp_support_change_bool
               \bool_set_true:N \l__sot_comp_explicit_transport_required_bool}
            {rename}
              {\bool_set_true:N \l__sot_comp_explicit_transport_required_bool}
            {discretize}
              {\bool_set_true:N \l__sot_comp_support_change_bool
               \bool_set_true:N \l__sot_comp_explicit_transport_required_bool
               \bool_set_true:N \l__sot_comp_paired_required_bool}
