\cs_new:Npn \__sot_stopped_comparison_glyph:
  {
    %% A refusal is not a third answer relation and therefore must not borrow
    %% \dashv (reverse turnstile).  This small two-sided break is the linear
    %% counterpart of the dependency-indexed gap in the incidence span.  The
    %% adjacent full words carry the accessible text; the rules carry no
    %% independent truth-conditional meaning.
    \ensuremath
      {\mathrel
        {\vcenter{\hbox
           {\raisebox{.22ex}{\rule{.32em}{.45pt}}%
            \kern-.02em\rule[-.28ex]{.45pt}{1.05ex}%
            \kern.18em
            \rule[-.28ex]{.45pt}{1.05ex}\kern-.02em%
            \raisebox{.22ex}{\rule{.32em}{.45pt}}}}}}
  }

