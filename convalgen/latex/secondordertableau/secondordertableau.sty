%% Query-relevant differences are not decorations: every light microcell is a
%% member of the declared complete mismatch set, and the heavier `w' microcell
%% selects one witness without hiding its siblings.  Cell anchors use a small
%% open/filled triangle in the ordinary tabular padding beside the incidence
%% bracket; printing Delta^w on the cell value itself could obscure a fatal OT
%% mark.  The centre sits 2.05pt past the content edge and the local incidence
%% bracket closes at 4.2pt: the 2.1pt triangle therefore retains about 1pt of
%% vector clearance on both sides inside the native 5pt cell padding.  In
%% particular, it neither joins the incidence bracket nor disappears into a
%% terminal tableau rule.  Header anchors retain the fuller labelled
%% microcell.  Input, row, and fibre markers occupy a query-indexed gutter to
%% the right of the complete grid, so they never cover candidate labels or
%% fatal marks and two queries on the same row never collide.
\cs_new_protected:Npn \__sot_draw_mismatch_marker:nnnn #1#2#3#4
  {
    \__sot_resolve_source_anchor:nN {#3} \l__sot_resolved_anchor_tl
    \tl_set:Nn \l_tmpa_tl {#3}
    \tl_trim_spaces:N \l_tmpa_tl
    \bool_set_false:N \l_tmpa_bool
    \bool_set_false:N \l_tmpb_bool
    \str_if_eq:VnT \l_tmpa_tl {input}
      {\bool_set_true:N \l_tmpa_bool}
    \regex_match:nVT {\A(?:row|fibre):} \l_tmpa_tl
      {\bool_set_true:N \l_tmpa_bool}
    \regex_match:nVT {\A(?:constraint|boundary|metric):} \l_tmpa_tl
      {\bool_set_true:N \l_tmpb_bool}
    \begin{tikzpicture}[remember~picture,overlay]
      \bool_if:NTF \l__sot_resolved_anchor_inner_bool
        {\__sot_compute_anchor_x_correction:N
           \l__sot_anchor_x_correction_dim}
        {\dim_zero:N \l__sot_anchor_x_correction_dim}
      \bool_if:NT \l__sot_resolved_anchor_boundary_bool
        {\dim_add:Nn \l__sot_anchor_x_correction_dim
           {\g__sot_comp_source_tabcolsep_dim}}
      \bool_if:NTF \l_tmpa_bool
        {
          %% Work in the row anchor's remembered coordinate system.  The
          %% source grid is captured before the outer composition is placed,
          %% and XeTeX in particular may retain a different x origin for its
          %% inner nodes.  The measured grid--row displacement cancels that
          %% origin difference while preserving the exact row-centre y.
          \pgfextractx{\l_tmpa_dim}
            {\pgfpointanchor
              {sot-\int_use:N \g__sot_comp_source_serial_int-grid-grid}{east}}
          \pgfextractx{\l_tmpb_dim}
            {\pgfpointanchor{\l__sot_resolved_anchor_tl}{east}}
          \dim_set:Nn \l_tmpa_dim
            {\l_tmpa_dim-\l_tmpb_dim+16pt*#1-12pt}
          \coordinate
            (sot-mismatch-\int_use:N \g__sot_comp_source_serial_int-#1-#2)
            at ([xshift=\l_tmpa_dim]\l__sot_resolved_anchor_tl.east);
          \str_if_eq:nnTF {#4}{selected}
            {\node[anchor=west,draw=sotSecondOrder,fill=white,
                line~width=.65pt,rounded~corners=.55pt,
                inner~xsep=.8pt,inner~ysep=.25pt,outer~sep=0pt,
                font=\tiny]
               at (sot-mismatch-\int_use:N
                    \g__sot_comp_source_serial_int-#1-#2)
               {\ensuremath{\Delta\sb{#1}\sp{\mathrm{w}}}};}
            {\node[anchor=west,draw=sotSecondOrder!58,fill=white,
                line~width=.35pt,rounded~corners=.55pt,
                inner~xsep=.65pt,inner~ysep=.18pt,outer~sep=0pt,
                font=\tiny]
               at (sot-mismatch-\int_use:N
                    \g__sot_comp_source_serial_int-#1-#2)
               {\ensuremath{\Delta\sb{#1}}};}
        }
        {
          \bool_if:NTF \l__sot_resolved_anchor_cell_bool
            {
              \coordinate
                (sot-mismatch-\int_use:N
                  \g__sot_comp_source_serial_int-#1-#2)
                at ([xshift=\dim_eval:n
                       {\l__sot_anchor_x_correction_dim+2.05pt}]
                    \l__sot_resolved_anchor_tl.east);
              \str_if_eq:nnTF {#4}{selected}
                {\fill[sotSecondOrder]
                   ([yshift=1.25pt]
                     sot-mismatch-\int_use:N
                       \g__sot_comp_source_serial_int-#1-#2)
                   --++(1.05pt,-2.1pt)
                   --++(-2.1pt,0pt)--cycle;}
                {\draw[sotSecondOrder!58,
                    line~width=\g__sot_comp_source_rule_dim]
                   ([yshift=1.25pt]
                     sot-mismatch-\int_use:N
                       \g__sot_comp_source_serial_int-#1-#2)
                   --++(1.05pt,-2.1pt)
                   --++(-2.1pt,0pt)--cycle;}
            }
            {
          \bool_if:NTF \l_tmpb_bool
            {
              \coordinate
                (sot-mismatch-\int_use:N
                  \g__sot_comp_source_serial_int-#1-#2)
                at ([xshift=\l__sot_anchor_x_correction_dim,yshift=.65pt]
                    \l__sot_resolved_anchor_tl.north~east);
              \str_if_eq:nnTF {#4}{selected}
                {\node[anchor=south~east,draw=sotSecondOrder,fill=white,
                    line~width=.65pt,rounded~corners=.55pt,
                    inner~xsep=.8pt,inner~ysep=.25pt,outer~sep=0pt,
                    font=\tiny]
                   at (sot-mismatch-\int_use:N
                        \g__sot_comp_source_serial_int-#1-#2)
                   {\ensuremath{\Delta\sb{#1}\sp{\mathrm{w}}}};}
                {\node[anchor=south~east,draw=sotSecondOrder!58,fill=white,
                    line~width=.35pt,rounded~corners=.55pt,
                    inner~xsep=.65pt,inner~ysep=.18pt,outer~sep=0pt,
                    font=\tiny]
                   at (sot-mismatch-\int_use:N
                        \g__sot_comp_source_serial_int-#1-#2)
                   {\ensuremath{\Delta\sb{#1}}};}
            }
            {
              \coordinate
                (sot-mismatch-\int_use:N
                  \g__sot_comp_source_serial_int-#1-#2)
                at ([xshift=\dim_eval:n
                       {\l__sot_anchor_x_correction_dim-.55pt},
                     yshift=-.45pt]
                    \l__sot_resolved_anchor_tl.north~east);
              \str_if_eq:nnTF {#4}{selected}
                {\node[anchor=north~east,draw=sotSecondOrder,fill=white,
                    line~width=.65pt,rounded~corners=.55pt,
                    inner~xsep=.8pt,inner~ysep=.25pt,outer~sep=0pt,
                    font=\tiny]
                   at (sot-mismatch-\int_use:N
                        \g__sot_comp_source_serial_int-#1-#2)
                   {\ensuremath{\Delta\sb{#1}\sp{\mathrm{w}}}};}
                {\node[anchor=north~east,draw=sotSecondOrder!58,fill=white,
                    line~width=.35pt,rounded~corners=.55pt,
                    inner~xsep=.65pt,inner~ysep=.18pt,outer~sep=0pt,
                    font=\tiny]
                   at (sot-mismatch-\int_use:N
                        \g__sot_comp_source_serial_int-#1-#2)
                   {\ensuremath{\Delta\sb{#1}}};}
            }
            }
        }
    \end{tikzpicture}
  }

\cs_new_protected:Npn \__sot_draw_mismatch_set:nnn #1#2#3
  {
    \clist_set:Nn \l_tmpa_clist {#3}
    \int_zero:N \l_tmpa_int
    \clist_map_inline:Nn \l_tmpa_clist
      {
        \int_incr:N \l_tmpa_int
        \tl_set:Nn \l_tmpa_tl {##1}
        \tl_trim_spaces:N \l_tmpa_tl
        %% The anchor resolver used by the drawing call legitimately reuses
        %% l_tmpb_tl.  Restore the selected anchor before every comparison so
        %% a witness in the second or later mismatch cell cannot silently
        %% inherit the first drawing call's scratch state.
        \tl_set:Nn \l_tmpb_tl {#2}
        \tl_trim_spaces:N \l_tmpb_tl
        \tl_if_eq:NNTF \l_tmpa_tl \l_tmpb_tl
          {\exp_args:Nxx \__sot_draw_mismatch_marker:nnnn
             {#1}{\int_use:N \l_tmpa_int}{##1}{selected}}
          {\exp_args:Nxx \__sot_draw_mismatch_marker:nnnn
             {#1}{\int_use:N \l_tmpa_int}{##1}{member}}
      }
  }

\cs_new_protected:Npn \__sot_draw_map_connector:nnn #1#2#3
  {
    \__sot_resolve_source_anchor:nN {#3} \l__sot_resolved_anchor_tl
    \begin{tikzpicture}[remember~picture,overlay,color=sotSecondOrder]
      \bool_if:NTF \l__sot_resolved_anchor_inner_bool
        {\__sot_compute_anchor_x_correction:N
           \l__sot_anchor_x_correction_dim}
        {\dim_zero:N \l__sot_anchor_x_correction_dim}
      \bool_if:NT \l__sot_resolved_anchor_boundary_bool
        {\dim_add:Nn \l__sot_anchor_x_correction_dim
           {\g__sot_comp_source_tabcolsep_dim}}
      \bool_if:NTF \l__sot_resolved_anchor_inner_bool
        {
          %% The leader leaves from the grid edge on the exact semantic band.
          %% A glyph-adjacent endpoint mark can masquerade as a phonological
          %% prime or degree sign, so the unchanged source cell remains clean.
          \draw[-{Stealth[length=3pt,width=2.2pt]},
            line~width=\g__sot_comp_source_rule_dim]
            (sot-\int_use:N \g__sot_comp_source_serial_int-grid-grid.east
              |- \l__sot_resolved_anchor_tl.center)
            --(sot-\int_use:N \g__sot_comp_source_serial_int-sidecar-sidecar.west
               |- sot-\int_use:N \g__sot_comp_source_serial_int-map-#2.west);
        }
        {
          \draw[-{Stealth[length=3pt,width=2.2pt]},
            line~width=\g__sot_comp_source_rule_dim]
            (\l__sot_resolved_anchor_tl.east)
            --(sot-\int_use:N \g__sot_comp_source_serial_int-sidecar-sidecar.west
               |- sot-\int_use:N \g__sot_comp_source_serial_int-map-#2.west);
        }
    \end{tikzpicture}
  }

\cs_new_protected:Npn \__sot_resolve_composition_mode:
  {
    \int_compare:nNnTF {\g__sot_comp_table_int} = {2}
      {\tl_set:Nn \l__sot_comp_resolved_mode_tl {paired}}
      {
        \seq_if_empty:NTF \l__sot_comp_map_seq
          {\tl_set:Nn \l__sot_comp_resolved_mode_tl {overlay}}
          {\tl_set:Nn \l__sot_comp_resolved_mode_tl {delta-sidecar}}
      }
    \str_if_eq:VnF \l__sot_comp_mode_tl {auto}
      {
        \tl_if_eq:NNTF \l__sot_comp_mode_tl \l__sot_comp_resolved_mode_tl
          {}
          {
            \PackageError{secondordertableau}
              {mode=\l__sot_comp_mode_tl\space conflicts~with~the~composed~material}
              {Omit~mode~and~let~the~presence~of~maps~or~a~second~tableau~choose~the~geometry.}
          }
      }
  }

\cs_new_protected:Npn \__sot_prepare_sorted_maps:
  {
    \seq_set_eq:NN \l__sot_comp_sorted_map_id_seq
      \l__sot_comp_map_id_seq
    \prop_gclear:N \l__sot_comp_map_y_prop
    \begin{tikzpicture}[remember~picture,overlay]
      \seq_map_inline:Nn \l__sot_comp_sorted_map_id_seq
        {
          \prop_get:NnN \l__sot_comp_map_anchor_prop {##1} \l_tmpa_tl
          \__sot_resolve_source_anchor:VN
            \l_tmpa_tl \l__sot_resolved_anchor_tl
          \pgfextracty{\l_tmpa_dim}
            {\pgfpointanchor{\l__sot_resolved_anchor_tl}{center}}
          \prop_gput:Nnx \l__sot_comp_map_y_prop {##1}
            {\dim_use:N \l_tmpa_dim}
        }
    \end{tikzpicture}
    %% Top-to-bottom source order yields top-to-bottom sidecar order.  Stable
    %% declaration order is retained when two semantic anchors share a band.
    \seq_sort:Nn \l__sot_comp_sorted_map_id_seq
      {
        \dim_compare:nNnTF
          {\prop_item:Nn \l__sot_comp_map_y_prop {##1}}
          <
          {\prop_item:Nn \l__sot_comp_map_y_prop {##2}}
          {\sort_return_swapped:}
          {\sort_return_same:}
      }
  }

\cs_new_protected:Npn \__sot_use_sorted_maps:
  {
    \seq_map_inline:Nn \l__sot_comp_sorted_map_id_seq
      {\prop_item:Nn \l__sot_comp_map_record_prop {##1}}
  }

