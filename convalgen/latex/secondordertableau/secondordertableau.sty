          }
        {2}
          {
            \box_gset_eq:NN \g__sot_comp_target_box \l__sot_output_box
            \int_gset_eq:NN \g__sot_comp_target_serial_int
              \l__sot_table_serial_int
            \tl_gset_eq:NN \g__sot_comp_target_id_tl
              \l__sot_table_id_safe_tl
            \dim_gset_eq:NN \g__sot_comp_target_rule_dim \l__sot_rule_dim
            \dim_gset_eq:NN \g__sot_comp_target_tabcolsep_dim
              \l__sot_table_tabcolsep_dim
            \dim_gset_eq:NN \g__sot_comp_target_inner_offset_dim
              \l__sot_table_inner_offset_dim
            \seq_gset_eq:NN \g__sot_comp_target_independent_boundary_seq
              \l__sot_independent_boundary_seq
            \prop_gset_eq:NN \g__sot_comp_target_ids_prop \l__sot_id_prop
            \prop_gput:Nnn \g__sot_comp_target_ids_prop {special/grid} {true}
            \prop_gput:Nnn \g__sot_comp_target_ids_prop {special/input} {true}
            \tl_if_blank:VF \l__sot_normalizer_tl
