      {\dim_add:Nn \l__sot_anchor_x_correction_dim
         {\g__sot_comp_source_tabcolsep_dim}}
      \bool_if:NTF \l__sot_resolved_anchor_cell_bool
        {
          \draw[line~width=\g__sot_comp_source_rule_dim]
            ([xshift=\dim_eval:n
                {\l__sot_anchor_x_correction_dim-1.7pt},yshift=1.2pt]
