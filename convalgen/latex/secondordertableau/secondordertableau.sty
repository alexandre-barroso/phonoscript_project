\cs_new_protected:Npn \__sot_validate_composition:
  {
    \int_compare:nNnF {\g__sot_comp_table_int} > {0}
      {\PackageError{secondordertableau}
         {A~secondordertableau~requires~a~sottableau}
         {Place~the~unchanged~first-order~tableau~inside~the~composition.}}
    \int_compare:nNnT {\g__sot_comp_table_int} > {2}
      {\PackageError{secondordertableau}
         {A~secondordertableau~contains~more~than~two~tableaux}
         {Compose~one~source~or~one~source--target~pair.}}
    \tl_if_blank:VT \l__sot_comp_alt_text_tl
      {\PackageError{secondordertableau}
         {A~secondordertableau~requires~alt-text}
         {Describe~the~source~tableau,~the~added~query~or~change,~and~the~result.}}
    \str_if_eq:VnT \l__sot_comp_disclosure_tl {audit}
      {
        \tl_if_blank:VT \l__sot_comp_source_name_tl
          {\PackageError{secondordertableau}
             {An~audit~composition~requires~a~source~identifier}
             {Set~source=...~to~the~registered~source~analysis~or~record.}}
        \tl_if_blank:VT \l__sot_comp_target_name_tl
          {\PackageError{secondordertableau}
             {An~audit~composition~requires~a~target~identifier}
             {Set~target=...~to~the~registered~target~or~reconstructed~analysis.}}
        \tl_if_blank:VT \l__sot_comp_transformation_tl
          {\PackageError{secondordertableau}
             {An~audit~composition~requires~a~transformation~identifier}
             {Set~transformation=...,~or~use~a~registered~sotChange~profile~that~supplies~it.}}
      }
    \seq_if_empty:NT \l__sot_comp_query_seq
      {\seq_if_empty:NT \l__sot_comp_change_seq
        {\seq_if_empty:NT \l__sot_comp_map_seq
          {\bool_if:NF \l__sot_comp_had_invalid_query_bool
             {\PackageError{secondordertableau}
                {The~composition~adds~nothing~to~its~first-order~tableau}
                {Use~sottableau~alone,~or~add~a~query,~change,~or~mapping.}}}}}
    \bool_if:NT \l__sot_comp_probability_evaluated_bool
      {\bool_if:NT \l__sot_comp_merge_bool
        {\bool_if:NF \l__sot_comp_mass_transport_bool
          {\__sot_lint:nnn {probability-merge-without-mass}
             {A~probability~query~crosses~a~merger~without~declared~mass~transport}
             {Add~mass-treatment=...~to~the~merge~map~and~name~the~complete~support~and~normalizer~dependencies.}}}}
    \bool_if:NT \l__sot_comp_mixed_layers_bool
      {
        \bool_set_false:N \l_tmpa_bool
        \int_compare:nNnT {\g__sot_comp_table_int} = {2}
          {\bool_if:NT \l__sot_comp_layer_bridge_bool
             {\bool_set_true:N \l_tmpa_bool}}
        \bool_if:NF \l_tmpa_bool
          {\__sot_lint:nnn {mixed-query-layers}
             {Stacked~queries~declare~different~scientific~layers~without~a~paired~layer~bridge}
             {Use~one~layer~per~composition,~or~supply~two~tableaux~and~an~explicit~profile=move-layer~transport.}}
      }
    \bool_if:NT \l__sot_comp_support_change_bool
      {\seq_if_empty:NT \l__sot_comp_map_seq
        {\int_compare:nNnTF {\g__sot_comp_table_int} = {1}
          {\__sot_lint:nnn {support-change-in-overlay}
             {A~support-changing~profile~cannot~use~direct~overlay~alone}
             {Add~the~complete~delta~map,~or~supply~a~separate~target~tableau~when~shared~geometry~is~dishonest.}}
          {\__sot_lint:nnn {paired-support-change-without-map}
             {Paired~tableaux~with~different~support~require~an~explicit~transport~map}
             {Add~a~sotMap~that~names~the~source,~target,~and~complete~support~relation.}}}}
    \bool_if:NT \l__sot_comp_explicit_transport_required_bool
      {\bool_if:NT \l__sot_comp_evaluated_query_bool
        {\seq_if_empty:NT \l__sot_comp_map_seq
          {\bool_if:NF \l__sot_comp_nonidentity_transport_bool
            {\__sot_lint:nnn {nonidentity-profile-without-transport}
               {The~selected~transformation~profile~requires~an~explicit~query~transport}
               {Name~the~nonidentity~transport~on~the~query,~or~add~a~complete~sotMap.}}}}}
    \bool_if:NT \l__sot_comp_paired_required_bool
      {\int_compare:nNnF {\g__sot_comp_table_int} = {2}
        {\__sot_lint:nnn {paired-profile-without-target}
           {The~selected~transformation~profile~requires~separate~source~and~target~tableaux}
           {Supply~the~target~tableau;~the~package~will~not~pretend~that~incompatible~carriers,~evaluators,~stages,~or~layers~share~one~grid.}}}
    \bool_if:nT
      {\l__sot_comp_collapse_trace_bool && \l__sot_comp_trace_bool}
      {\int_compare:nNnF {\g__sot_comp_table_int} = {2}
        {\__sot_lint:nnn {trace-collapse-without-paired-traces}
           {A~trace~query~under~profile=collapse-trace~requires~paired~trace~geometry}
           {Supply~both~registered~stage~sequences~and~their~complete~stage~map,~or~restrict~the~query~to~terminal-output.}}}
  }

