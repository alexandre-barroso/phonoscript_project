                      {\clist_item:Nn \l__sot_cells_clist {##1}}
                    \tl_if_in:VnT \l_tmpa_tl {!}
                      {\int_set:Nn \l__sot_fatal_int {##1}}
                  }
              }
          }
          {
            \regex_match:nVTF {\A[0-9]+\Z}
              \l__sot_candidate_fatal_tl
              {
                \int_set:Nn \l__sot_fatal_int {\l__sot_candidate_fatal_tl}
                \int_compare:nNnT {\l__sot_fatal_int} < {1}
                  {\PackageError{secondordertableau}
                     {Candidate~fatal~index~must~be~positive}
                     {Use~fatal=none,~fatal=auto,~or~an~existing~constraint~index.}}
                \int_compare:nNnT {\l__sot_fatal_int} >
                  {\seq_count:N \l__sot_constraint_name_seq}
                  {\PackageError{secondordertableau}
                     {Candidate~fatal~index~\int_use:N \l__sot_fatal_int
                      ~exceeds~the~constraint~count}
                     {Use~fatal=none,~fatal=auto,~or~an~existing~constraint~index.}}
              }
              {\PackageError{secondordertableau}
                 {Invalid~candidate~fatal~value~`\l__sot_candidate_fatal_tl'}
                 {Use~fatal=auto,~fatal=none,~or~a~positive~constraint~index.}}
          }
      }
  }

