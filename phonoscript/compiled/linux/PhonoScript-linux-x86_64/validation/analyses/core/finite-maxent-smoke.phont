#!/usr/bin/env phonoscript
// Generic finite MaxEnt normalization smoke test; not a source transcription.
project_title("Generic finite MaxEnt normalizer smoke test")
project_evaluator("MaxEnt")
project_temperature(1)
dataset_clear()
tableau_select("source")
tableau_name("Generic equal-cost variants")
tableau_input("/naapuri/")
constraints_clear()
candidates_clear()
constraint_add("C1", 2)
constraint_add("C2", 1)
constraint_add("C3", 1/2)
candidate_add("weak", "naapurien", [0, 1, 2])
candidate_add("strong", "naapureiden", [1, 0, 0])
assert_equal(harmony("weak"), 2)
assert_equal(harmony("strong"), 2)
assert_winners(["weak", "strong"])
assert_probability("weak", 1/2, 1/1000000000000)
assert_probability("strong", 1/2, 1/1000000000000)
let result = evaluate()
assert_equal(result["evaluator"], "MaxEnt")
