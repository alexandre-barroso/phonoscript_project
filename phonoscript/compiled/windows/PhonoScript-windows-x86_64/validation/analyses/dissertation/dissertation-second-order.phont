#!/usr/bin/env phonoscript
// Label-preserving reparameterization of fig:intro-sot-opening: the winner is
// retained while the two losers reverse. Candidate and constraint names are
// pedagogical replacements, so the fidelity ceiling is exact-transform.
project_title("Typed comparison of independently calculated orders")
project_evaluator("OT")
dataset_clear()

tableau_select("source")
tableau_name("Source")
tableau_input("/ab/")
tableau_source_locator("Dissertation EN/PT-BR; fig:intro-sot-opening; panel:intro-neutral-source; fidelity:exact-transform (candidate and constraint labels reparameterized)")
constraints_clear()
candidates_clear()
constraint_add("IDENT-IO(voice)", 1, "", 0)
constraint_add("MAX-IO", 1, "", 1)
candidate_add("ab", "[ab]", [0, 0])
candidate_add("ap", "[ap]", [1, 0])
candidate_add("a", "[a]", [0, 1])
assert_winners(["ab"])

tableau_select("target")
tableau_name("Target")
tableau_input("/ab/")
tableau_source_locator("Dissertation EN/PT-BR; fig:intro-sot-opening; encoded target response; fidelity:exact-transform (candidate and constraint labels reparameterized)")
constraints_clear()
candidates_clear()
constraint_add("MAX-IO", 1, "", 0)
constraint_add("IDENT-IO(voice)", 1, "", 1)
candidate_add("ab", "[ab]", [0, 0])
candidate_add("ap", "[ap]", [0, 1])
candidate_add("a", "[a]", [1, 0])
assert_winners(["ab"])

second_query("complete_order")
second_answer_sort("complete preorder on registered candidates")
second_scope("ab, ap, and a")
second_transformation("rerank IDENT-IO(voice) and MAX-IO")
second_transport("identity on ab, ap, and a")
second_mode("exact")
let comparison = second_compare()
assert_equal(comparison["status"], "DISCREPANCY")
assert(not comparison["conservative"])
assert_equal(len(comparison["discrepancies"]), 2)
